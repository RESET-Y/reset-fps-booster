<Window x:Class="ResetFpsBooster.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True" Topmost="False"
        Width="1280" Height="820" ResizeMode="NoResize">
    <Grid x:Name="RootGrid" ClipToBounds="True">
        <Grid.Background>
            <SolidColorBrush Color="#000000"/>
        </Grid.Background>

        <!-- ============ Ambient background technical lines (system-init phase) ============ -->
        <Canvas x:Name="AmbientCanvas" IsHitTestVisible="False"/>

        <!-- ============ Phase 1+2: center line + logo assembly ============ -->
        <Grid x:Name="LogoStage" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border x:Name="CenterLine" Width="4" Height="2" Background="#FF1A25" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect x:Name="CenterLineGlow" Color="#FF1A25" BlurRadius="18" ShadowDepth="0" Opacity="0"/>
                </Border.Effect>
            </Border>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,60,0,0">
                <Grid x:Name="LogoHost" Width="360" Height="60" HorizontalAlignment="Center" Opacity="0">
                    <Image x:Name="LogoImage" Source="/Assets/logo_wide.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.5,0.5">
                        <Image.Effect>
                            <DropShadowEffect Color="#FF1A25" BlurRadius="22" ShadowDepth="0" Opacity="0.55"/>
                        </Image.Effect>
                        <Image.RenderTransform>
                            <TranslateTransform x:Name="LogoJitter"/>
                        </Image.RenderTransform>
                    </Image>
                    <Canvas x:Name="FragmentOverlay" Width="360" Height="60" IsHitTestVisible="False"/>
                </Grid>

                <TextBlock x:Name="SubtitleText" Text="P E R F O R M A N C E     E N G I N E"
                           FontFamily="Segoe UI" FontSize="12" Foreground="#B0AEAE"
                           HorizontalAlignment="Center" Margin="0,16,0,0" Opacity="0"/>
            </StackPanel>
        </Grid>

        <!-- ============ Phase 3: system initialization ============ -->
        <StackPanel x:Name="InitStage" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0">
            <TextBlock x:Name="InitCaption" Text="I N I T I A L I Z I N G   P E R F O R M A N C E   E N G I N E"
                       FontFamily="Segoe UI Semibold" FontSize="13" Foreground="#FFFFFF"
                       HorizontalAlignment="Center" Margin="0,0,0,28"/>
            <StackPanel x:Name="InitRowsPanel" Width="420"/>
        </StackPanel>

        <!-- ============ Phase 4: system scan ============ -->
        <Canvas x:Name="ScanStage" Opacity="0" IsHitTestVisible="False"/>

        <!-- ============ Phase 5: hero moment ============ -->
        <Grid x:Name="HeroStage" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0">
            <Ellipse x:Name="HeroGlow" Width="700" Height="360" Opacity="0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#33FF1A25" Offset="0"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <StackPanel.RenderTransform>
                    <ScaleTransform x:Name="HeroScale" ScaleX="0.96" ScaleY="0.96"/>
                </StackPanel.RenderTransform>
                <TextBlock x:Name="HeroText" Text="SYSTEM ONLINE" FontFamily="Segoe UI Semibold" FontSize="46"
                           Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                <Border x:Name="HeroLine" Height="2" Width="4" Background="#FF1A25" HorizontalAlignment="Center" Margin="0,18,0,0"/>
            </StackPanel>
        </Grid>

        <!-- ============ Phase 6: performance score ============ -->
        <StackPanel x:Name="ScoreStage" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0">
            <TextBlock Text="S Y S T E M   P E R F O R M A N C E" FontFamily="Segoe UI" FontSize="12" Foreground="#B0AEAE"
                       HorizontalAlignment="Center"/>
            <Grid HorizontalAlignment="Center" Margin="0,18,0,0">
                <TextBlock x:Name="ScoreNumberText" Text="0" FontFamily="Segoe UI Semibold" FontSize="96"
                           Foreground="#FFFFFF" HorizontalAlignment="Center"/>
            </Grid>
            <TextBlock Text="/ 100" FontFamily="Segoe UI" FontSize="16" Foreground="#6E6A6A" HorizontalAlignment="Center" Margin="0,-6,0,0"/>
            <TextBlock x:Name="ReadyText" Text="YOUR SYSTEM IS READY." FontFamily="Segoe UI Semibold" FontSize="14"
                       Foreground="#FF3242" HorizontalAlignment="Center" Margin="0,22,0,0" Opacity="0"/>
        </StackPanel>

        <!-- ============ Final transition: logo docks to sidebar position, top stripe forms ============ -->
        <Border x:Name="TopStripe" Height="3" VerticalAlignment="Top" HorizontalAlignment="Stretch" Opacity="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FF1A25" Offset="0"/>
                    <GradientStop Color="#FF3242" Offset="0.5"/>
                    <GradientStop Color="#FF1A25" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Image x:Name="DockingLogo" Source="/Assets/logo_wide.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
               Width="120" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0" RenderTransformOrigin="0,0">
            <Image.RenderTransform>
                <TranslateTransform/>
            </Image.RenderTransform>
        </Image>

        <!-- Full-window fade cover used between phases -->
        <Border x:Name="BlackCover" Background="#000000" Opacity="0" IsHitTestVisible="False"/>
    </Grid>
</Window>
