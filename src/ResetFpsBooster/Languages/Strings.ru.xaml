    <sys:String x:Key="FB.PremiumHint" xml:space="preserve">Войдите в аккаунт с Премиумом, чтобы включить FrameBoost.</sys:String>
    <sys:String x:Key="FB.GoToAccount" xml:space="preserve">Перейти в аккаунт</sys:String>
    <sys:String x:Key="FB.TurnOn" xml:space="preserve">Включить FrameBoost</sys:String>
