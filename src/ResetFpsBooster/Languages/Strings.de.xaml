    <sys:String x:Key="Mod.BackgroundApps.Name" xml:space="preserve">Store-Apps im Hintergrund</sys:String>
    <sys:String x:Key="Mod.BackgroundApps.Desc" xml:space="preserve">Verhindert, dass Microsoft-Store-Apps (UWP) im Hintergrund laufen und synchronisieren, wenn du sie nicht benutzt.</sys:String>
    <sys:String x:Key="Mod.GameDvr.Name" xml:space="preserve">Spielaufnahme im Hintergrund (Game DVR)</sys:String>
    <sys:String x:Key="Mod.GameDvr.Desc" xml:space="preserve">Schaltet den Aufnahmepuffer der Xbox Game Bar ab, der ständig mitschneidet, und entlastet so CPU, GPU und Festplatte.</sys:String>
    <sys:String x:Key="Mod.GameMode.Name" xml:space="preserve">Windows-Spielmodus</sys:String>
    <sys:String x:Key="Mod.GameMode.Desc" xml:space="preserve">Lässt Windows dein Spiel bei CPU und GPU vor Hintergrundaufgaben bevorzugen, solange es im Vordergrund ist.</sys:String>
    <sys:String x:Key="Mod.GpuPriority.Name" xml:space="preserve">Priorität für Spiele im Task-Planer</sys:String>
    <sys:String x:Key="Mod.GpuPriority.Desc" xml:space="preserve">Hebt die CPU/GPU-Priorität an, die Windows der eingebauten Multimedia-Kategorie „Games“ (MMCSS) gibt.</sys:String>
    <sys:String x:Key="Mod.Hags.Name" xml:space="preserve">Hardwarebeschleunigte GPU-Planung</sys:String>
    <sys:String x:Key="Mod.Hags.Desc" xml:space="preserve">Lässt eine kompatible GPU ihre Grafikspeicher-Warteschlange selbst verwalten, für weniger Latenz. Wirkt erst nach einem Neustart.</sys:String>
    <sys:String x:Key="Mod.Network.Name" xml:space="preserve">Netzwerkdrosselung</sys:String>
    <sys:String x:Key="Mod.Network.Desc" xml:space="preserve">Entfernt die Grenze von rund 10.000 Paketen pro Sekunde, die Windows setzt, solange Multimedia oder ein Spiel läuft.</sys:String>
    <sys:String x:Key="Mod.Nvidia.Name" xml:space="preserve">NVIDIA Maximale Leistung</sys:String>
    <sys:String x:Key="Mod.Nvidia.Desc" xml:space="preserve">Setzt NVIDIAs globales Treiberprofil auf Energieverwaltung: Maximale Leistung bevorzugen, Threaded Optimization: Ein, Texturfilterung: Hohe Leistung und V-Sync: Aus – dieselben Einstellungen wie in der NVIDIA-Systemsteuerung unter „3D-Einstellungen verwalten“.</sys:String>
    <sys:String x:Key="Mod.PowerPlan.Name" xml:space="preserve">Energiesparplan Höchstleistung</sys:String>
    <sys:String x:Key="Mod.PowerPlan.Desc" xml:space="preserve">Stellt den Energiesparplan von Ausbalanciert auf Höchstleistung, damit die CPU beim Spielen nicht zum Stromsparen heruntertaktet.</sys:String>
    <sys:String x:Key="Mod.PowerThrottling.Name" xml:space="preserve">CPU-Energiedrosselung</sys:String>
    <sys:String x:Key="Mod.PowerThrottling.Desc" xml:space="preserve">Schaltet die automatische Energiedrosselung von Hintergrundprozessen ab. Auf Laptops kann das im Akkubetrieb Laufzeit kosten.</sys:String>
    <sys:String x:Key="Mod.RamCleaner.Name" xml:space="preserve">RAM-Reiniger</sys:String>
    <sys:String x:Key="Mod.RamCleaner.Desc" xml:space="preserve">Verkleinert den Speicher untätiger Hintergrundprozesse und leert den freigebbaren Datei-Cache von Windows (Standby-Liste). Nichts wird geschlossen, keine Daten gehen verloren – Windows gibt nur Speicher zurück, der gerade nicht gebraucht wird.</sys:String>
    <sys:String x:Key="Mod.Startup.Name" xml:space="preserve">Autostart-Optimierung</sys:String>
    <sys:String x:Key="Mod.Startup.Desc" xml:space="preserve">Deaktiviert typische unnötige Autostart-Helfer (z. B. OneDrive, Spotify, Adobe-Updater). Spieleplattformen und Treiber bleiben immer unberührt. Vollständig umkehrbar.</sys:String>
    <sys:String x:Key="Mod.TempFiles.Name" xml:space="preserve">Temp-Dateien bereinigen</sys:String>
    <sys:String x:Key="Mod.TempFiles.Desc" xml:space="preserve">Löscht übrig gebliebene Dateien aus deinen Benutzer- und System-Temp-Ordnern. Das lässt sich nicht rückgängig machen.</sys:String>
    <sys:String x:Key="Mod.VisualEffects.Name" xml:space="preserve">Visuelle Effekte</sys:String>
    <sys:String x:Key="Mod.VisualEffects.Desc" xml:space="preserve">Schaltet Fensteranimationen, Transparenz und Schatten ab, damit der Desktop weniger GPU-Zeit braucht. Optional – rein optisch, beeinflusst keine Spiele.</sys:String>
