    <sys:String x:Key="FB.PremiumHint" xml:space="preserve">Melde dich mit einem Konto mit Premium an, um FrameBoost einzuschalten.</sys:String>
    <sys:String x:Key="FB.GoToAccount" xml:space="preserve">Zum Konto</sys:String>
    <sys:String x:Key="FB.TurnOn" xml:space="preserve">FrameBoost einschalten</sys:String>
