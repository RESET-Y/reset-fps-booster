    <sys:String x:Key="Mod.BackgroundApps.Name" xml:space="preserve">Background Store Apps</sys:String>
    <sys:String x:Key="Mod.BackgroundApps.Desc" xml:space="preserve">Prevents Microsoft Store (UWP) apps from running and syncing in the background when you're not using them.</sys:String>
    <sys:String x:Key="Mod.GameDvr.Name" xml:space="preserve">Background Game Recording (Game DVR)</sys:String>
    <sys:String x:Key="Mod.GameDvr.Desc" xml:space="preserve">Disables the Xbox Game Bar background capture buffer that continuously records gameplay, freeing up CPU, GPU and disk I/O.</sys:String>
    <sys:String x:Key="Mod.GameMode.Name" xml:space="preserve">Windows Game Mode</sys:String>
    <sys:String x:Key="Mod.GameMode.Desc" xml:space="preserve">Lets Windows prioritize your game's CPU and GPU scheduling over background tasks while it has focus.</sys:String>
    <sys:String x:Key="Mod.GpuPriority.Name" xml:space="preserve">Gaming Task Scheduler Priority</sys:String>
    <sys:String x:Key="Mod.GpuPriority.Desc" xml:space="preserve">Raises the CPU/GPU scheduling priority Windows grants to the built-in &quot;Games&quot; multimedia task category used by MMCSS.</sys:String>
    <sys:String x:Key="Mod.Hags.Name" xml:space="preserve">Hardware-Accelerated GPU Scheduling</sys:String>
    <sys:String x:Key="Mod.Hags.Desc" xml:space="preserve">Lets a compatible GPU manage its own video memory queue for lower latency. Requires a restart to take effect.</sys:String>
    <sys:String x:Key="Mod.Network.Name" xml:space="preserve">Network Throttling Index</sys:String>
    <sys:String x:Key="Mod.Network.Desc" xml:space="preserve">Removes the ~10,000 packets/sec cap Windows applies to network traffic while a multimedia/gaming task is active.</sys:String>
    <sys:String x:Key="Mod.Nvidia.Name" xml:space="preserve">NVIDIA Max Performance</sys:String>
    <sys:String x:Key="Mod.Nvidia.Desc" xml:space="preserve">Sets NVIDIA's global driver profile to Power Management: Prefer Maximum Performance, Threaded Optimization: On, Texture Filtering: High Performance, and V-Sync: Off — the same settings the NVIDIA Control Panel exposes under &quot;Manage 3D Settings&quot;.</sys:String>
    <sys:String x:Key="Mod.PowerPlan.Name" xml:space="preserve">High Performance Power Plan</sys:String>
    <sys:String x:Key="Mod.PowerPlan.Desc" xml:space="preserve">Switches Windows' active power plan from Balanced to High Performance so the CPU doesn't downclock during gaming to save power.</sys:String>
    <sys:String x:Key="Mod.PowerThrottling.Name" xml:space="preserve">CPU Power Throttling</sys:String>
    <sys:String x:Key="Mod.PowerThrottling.Desc" xml:space="preserve">Disables Windows' automatic power throttling of background processes. On laptops this can reduce battery life on battery power.</sys:String>
    <sys:String x:Key="Mod.RamCleaner.Name" xml:space="preserve">RAM Cleaner</sys:String>
    <sys:String x:Key="Mod.RamCleaner.Desc" xml:space="preserve">Trims memory held by idle background processes and clears Windows' reclaimable file cache (Standby List). Nothing is closed and no data is lost — this only asks the OS to give back pages it isn't actively using.</sys:String>
    <sys:String x:Key="Mod.Startup.Name" xml:space="preserve">Startup Optimization</sys:String>
    <sys:String x:Key="Mod.Startup.Desc" xml:space="preserve">Disables common non-essential startup helpers (e.g. OneDrive, Spotify, Adobe updaters). Gaming platforms and drivers are never touched. Fully reversible.</sys:String>
    <sys:String x:Key="Mod.TempFiles.Name" xml:space="preserve">Temporary File Cleanup</sys:String>
    <sys:String x:Key="Mod.TempFiles.Desc" xml:space="preserve">Deletes leftover files from your user and system temp folders. This action cannot be undone.</sys:String>
    <sys:String x:Key="Mod.VisualEffects.Name" xml:space="preserve">Visual Effects</sys:String>
    <sys:String x:Key="Mod.VisualEffects.Desc" xml:space="preserve">Turns off window animations, transparency and shadows so the desktop compositor uses less GPU time. Optional — purely cosmetic, does not affect games.</sys:String>
