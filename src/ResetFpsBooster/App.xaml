<Application x:Class="ResetFpsBooster.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ResetFpsBooster.Converters"
             xmlns:vm="clr-namespace:ResetFpsBooster.ViewModels"
             xmlns:views="clr-namespace:ResetFpsBooster.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml"/>
                <ResourceDictionary Source="Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <conv:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True"/>
            <conv:NullToVisibilityConverter x:Key="NullToVis"/>
            <conv:NullToVisibilityConverter x:Key="InverseNullToVis" Invert="True"/>
            <conv:EnumEqualsConverter x:Key="EnumEquals"/>
            <conv:RiskLevelToBrushConverter x:Key="RiskToBrush"/>
            <conv:BytesToReadableConverter x:Key="BytesToReadable"/>
            <conv:BoolToTextConverter x:Key="BoolToYesNo" TrueText="Yes" FalseText="No"/>
            <conv:BoolToTextConverter x:Key="BoolToLaptopDesktop" TrueText="Laptop" FalseText="Desktop"/>
            <conv:BoolToTextConverter x:Key="BoolToEnabledDisabled" TrueText="Enabled" FalseText="Disabled"/>
            <conv:BoolToTextConverter x:Key="BoolToCheckmark" TrueText="✓" FalseText="…"/>
            <conv:InverseBoolConverter x:Key="InverseBool"/>
            <conv:CountToVisibilityConverter x:Key="CountToVisWhenZero" VisibleWhenZero="True"/>
            <conv:IconKindToGeometryConverter x:Key="IconToGeometry"/>

            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:OptimizerViewModel}">
                <views:OptimizerView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:GameProfilesViewModel}">
                <views:GameProfilesView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PerformanceViewModel}">
                <views:PerformanceView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:BottleneckEngineViewModel}">
                <views:BottleneckEngineView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SystemViewModel}">
                <views:SystemView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:BackupsViewModel}">
                <views:BackupsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:LogsViewModel}">
                <views:LogsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
