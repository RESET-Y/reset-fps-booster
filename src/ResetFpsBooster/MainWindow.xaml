<Window x:Class="ResetFpsBooster.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ResetFpsBooster.ViewModels"
        Title="RESET FPS BOOSTER"
        Width="1280" Height="820" MinWidth="1040" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Background}"
        FontFamily="Segoe UI"
        StateChanged="OnStateChanged">
    <!-- Our own title bar instead of the Windows one. WindowChrome keeps what
         the system frame gave: dragging, double-click to maximize, snapping,
         resizing at the edges. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.SurfaceHover}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Accent}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- A maximized borderless window reaches past the screen edge by the
         resize border; OnStateChanged pads it back in. -->
    <DockPanel x:Name="RootPanel">
        <!-- Title bar -->
        <Grid DockPanel.Dock="Top" Height="34" Background="{StaticResource Brush.Background}">
            <TextBlock Text="RESET FPS BOOSTER //" FontFamily="Segoe UI Black" FontStyle="Italic" FontSize="11"
                       Foreground="{StaticResource Brush.TextTertiary}" VerticalAlignment="Center" Margin="16,0,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource CaptionButton}" Click="OnMinimize" ToolTip="Minimize">
                    <Rectangle Width="10" Height="1.5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
                <Button Style="{StaticResource CaptionButton}" Click="OnMaximize" ToolTip="Maximize">
                    <Rectangle Width="10" Height="10" StrokeThickness="1.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
                <Button Style="{StaticResource CloseButton}" Click="OnClose" ToolTip="Close">
                    <Path Data="M0,0 L10,10 M10,0 L0,10" StrokeThickness="1.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Racing stripe: red band with slanted black hatching -->
        <Border DockPanel.Dock="Top" Height="6" Background="{DynamicResource Brush.Accent}">
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="8,6" MappingMode="Absolute" SpreadMethod="Repeat">
                        <GradientStop Color="#00000000" Offset="0"/><GradientStop Color="#00000000" Offset="0.5"/>
                        <GradientStop Color="#FF000000" Offset="0.5"/><GradientStop Color="#FF000000" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Border>

        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar: black, closed off by a red edge -->
        <Border Grid.Column="0" Background="{StaticResource Brush.Background}" BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="0,0,3,0" ClipToBounds="True">
          <Grid>
            <DockPanel LastChildFill="True" Margin="0,0,0,20">

                <!-- Brand -->
                <Border DockPanel.Dock="Top" Padding="24,26">
                    <StackPanel>
                        <Image Source="/Assets/logo_wide.png" Height="40" HorizontalAlignment="Left" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="RESET FPS BOOSTER //" FontFamily="Segoe UI Black" FontStyle="Italic" FontSize="10.5" Foreground="{StaticResource Brush.TextTertiary}"
                                   Margin="2,8,0,0">
                            <TextBlock.LayoutTransform>
                                <ScaleTransform ScaleX="1.06"/>
                            </TextBlock.LayoutTransform>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Footer / branding -->
                <StackPanel DockPanel.Dock="Bottom" Margin="24,12,24,0">
                    <Border Background="{StaticResource Brush.SurfaceElevated}" BorderBrush="{StaticResource Brush.Warning}" BorderThickness="3,0,0,0" Padding="12,10" Margin="0,0,0,14"
                            Visibility="{Binding IsAdministrator, Converter={StaticResource InverseBoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Shell.StandardMode}" Foreground="{StaticResource Brush.TextPrimary}" FontFamily="Segoe UI Semibold" FontSize="12"/>
                            <TextBlock Text="{DynamicResource Shell.NeedsAdmin}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="2,0,0,0" Padding="10,0,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Shell.MadeBy}" FontSize="11" Foreground="{StaticResource Brush.TextTertiary}"/>
                            <TextBlock Text="Lukas Reschke" Foreground="White" FontFamily="Segoe UI Black" FontStyle="Italic" FontSize="12" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Navigation: scrolls when the window is too short for every page -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding NavigationItems}" Margin="0,14,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:NavigationItem}">
                                <RadioButton GroupName="Nav" Style="{StaticResource NavItem}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                             Command="{Binding DataContext.NavigateToCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                             CommandParameter="{Binding Section}" Margin="0,2">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{Binding Icon, Converter={StaticResource IconToGeometry}}" Fill="White"
                                              Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <TextBlock Text="{Binding Label, Converter={StaticResource ToUpper}}" FontSize="13" FontFamily="Segoe UI Black" FontStyle="Italic" VerticalAlignment="Center"
                                                   Foreground="White"/>
                                    </StackPanel>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
          </Grid>
        </Border>

        <!-- Content -->
        <ContentControl x:Name="ContentHost" Grid.Column="1" Content="{Binding CurrentViewModel}" Margin="0"/>
        </Grid>
    </DockPanel>
</Window>
