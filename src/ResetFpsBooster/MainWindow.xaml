<Window x:Class="ResetFpsBooster.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ResetFpsBooster.ViewModels"
        Title="RESET FPS BOOSTER"
        Width="1280" Height="820" MinWidth="1040" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Background}"
        FontFamily="Segoe UI">
    <DockPanel>
        <!-- Racing-stripe top accent -->
        <Border DockPanel.Dock="Top" Height="3" Background="{StaticResource Brush.AccentGradientHorizontal}"/>

        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Accent}" BorderThickness="0,0,1,0" ClipToBounds="True">
          <Grid>
            <!-- Decorative diagonal accent stripes, bottom-left -->
            <Canvas IsHitTestVisible="False">
                <Rectangle Canvas.Left="-60" Canvas.Top="560" Width="260" Height="6" Fill="{StaticResource Brush.Accent}" Opacity="0.5">
                    <Rectangle.RenderTransform>
                        <RotateTransform Angle="-58"/>
                    </Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle Canvas.Left="-40" Canvas.Top="620" Width="220" Height="3" Fill="{StaticResource Brush.Accent}" Opacity="0.3">
                    <Rectangle.RenderTransform>
                        <RotateTransform Angle="-58"/>
                    </Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle Canvas.Left="-90" Canvas.Top="500" Width="180" Height="2" Fill="{StaticResource Brush.Accent}" Opacity="0.2">
                    <Rectangle.RenderTransform>
                        <RotateTransform Angle="-58"/>
                    </Rectangle.RenderTransform>
                </Rectangle>
            </Canvas>

            <DockPanel LastChildFill="True" Margin="0,0,0,20">

                <!-- Brand -->
                <Border DockPanel.Dock="Top" Padding="24,26" BorderBrush="{StaticResource Brush.BorderSubtle}" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <Image Source="/Assets/logo_wide.png" Height="40" HorizontalAlignment="Left" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Effect>
                                <DropShadowEffect Color="#E8121F" BlurRadius="18" ShadowDepth="0" Opacity="0.55"/>
                            </Image.Effect>
                        </Image>
                        <TextBlock Text="RESET FPS BOOSTER" FontFamily="Segoe UI Semibold" FontSize="10.5" Foreground="{StaticResource Brush.TextTertiary}"
                                   Margin="2,8,0,0">
                            <TextBlock.LayoutTransform>
                                <ScaleTransform ScaleX="1.06"/>
                            </TextBlock.LayoutTransform>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Footer / branding -->
                <StackPanel DockPanel.Dock="Bottom" Margin="24,12,24,0">
                    <Border Background="{StaticResource Brush.SurfaceElevated}" CornerRadius="6" Padding="12,10" Margin="0,0,0,14"
                            Visibility="{Binding IsAdministrator, Converter={StaticResource InverseBoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Standard mode" Foreground="{StaticResource Brush.TextPrimary}" FontFamily="Segoe UI Semibold" FontSize="12"/>
                            <TextBlock Text="Some optimizations need administrator rights" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border BorderBrush="{StaticResource Brush.Accent}" BorderThickness="2,0,0,0" Padding="10,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Made by" Style="{StaticResource Text.Caption}"/>
                            <TextBlock Text="Lukas Reschke" Foreground="{StaticResource Brush.TextSecondary}" FontFamily="Segoe UI Semibold" FontSize="12" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Navigation -->
                <ItemsControl ItemsSource="{Binding NavigationItems}" Margin="14,10,14,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:NavigationItem}">
                            <RadioButton GroupName="Nav" Style="{StaticResource NavItem}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                         Command="{Binding DataContext.NavigateToCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                         CommandParameter="{Binding Section}" Margin="0,2">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{Binding Icon, Converter={StaticResource IconToGeometry}}" Fill="{StaticResource Brush.TextSecondary}"
                                          Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Text="{Binding Label}" FontSize="13.5" VerticalAlignment="Center"
                                               Foreground="{StaticResource Brush.TextPrimary}"/>
                                </StackPanel>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
          </Grid>
        </Border>

        <!-- Content -->
        <ContentControl x:Name="ContentHost" Grid.Column="1" Content="{Binding CurrentViewModel}" Margin="0"/>
        </Grid>
    </DockPanel>
</Window>
