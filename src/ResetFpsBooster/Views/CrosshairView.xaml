<UserControl x:Class="ResetFpsBooster.Views.CrosshairView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ResetFpsBooster.ViewModels"
             d:DataContext="{d:DesignInstance vm:CrosshairViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform"><Setter.Value><SkewTransform AngleX="-12"/></Setter.Value></Setter>
        </Style>
        <Style x:Key="BadgeText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Display}"/><Setter Property="FontWeight" Value="Black"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Display}"/><Setter Property="FontWeight" Value="Black"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RowValue" TargetType="TextBlock" BasedOn="{StaticResource Text.Telemetry}">
            <Setter Property="MinWidth" Value="52"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.AccentBright}"/>
        </Style>
        <Style x:Key="Point" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,32" MaxWidth="1040" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="CROSSHAIR" Style="{StaticResource Text.Title}"/>
                <Border Style="{StaticResource Badge}" Margin="16,6,0,0" VerticalAlignment="Top">
                    <TextBlock Text="NEW" Style="{StaticResource BadgeText}"/>
                </Border>
            </StackPanel>
            <TextBlock Style="{StaticResource Text.Body}" Margin="0,8,0,0" TextWrapping="Wrap" Text="{DynamicResource Cross.Intro}"/>

            <Grid Margin="0,20,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <!-- Settings -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Cross.ShapeLabel}" Style="{StaticResource RowLabel}"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Shapes}" SelectedItem="{Binding SelectedShape}" DisplayMemberPath="Label"/>
                        </Grid>

                        <Grid Margin="0,0,0,14" Visibility="{Binding HasSeveralScreens, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Cross.ScreenLabel}" Style="{StaticResource RowLabel}"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Screens}" SelectedItem="{Binding SelectedScreen}" DisplayMemberPath="Label"/>
                        </Grid>

                        <!-- Drawn shapes -->
                        <StackPanel Visibility="{Binding IsDrawn, Converter={StaticResource BoolToVis}}">
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Cross.ColorLabel}" Style="{StaticResource RowLabel}"/>
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding Swatches}" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.PickColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" Cursor="Hand" Margin="0,0,8,0" ToolTip="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="sw" Width="26" Height="26" Background="{Binding}" BorderBrush="{StaticResource Brush.Border}"
                                                                BorderThickness="2" RenderTransformOrigin="0.5,0.5">
                                                            <Border.RenderTransform><SkewTransform AngleX="-12"/></Border.RenderTransform>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="sw" Property="BorderBrush" Value="White"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBox Grid.Column="2" Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}" Width="96" MaxLength="7"
                                         VerticalAlignment="Center" FontFamily="Consolas"/>
                            </Grid>

                            <Grid Margin="0,0,0,10" Visibility="{Binding HasArms, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Cross.LengthLabel}" Style="{StaticResource RowLabel}"/>
                                <Slider Grid.Column="1" Minimum="1" Maximum="40" Value="{Binding Length}" IsSnapToTickEnabled="True" TickFrequency="1"
                                        Style="{StaticResource RacingSlider}" Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="2" Text="{Binding Length, StringFormat={}{0} px}" Style="{StaticResource RowValue}"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Cross.ThicknessLabel}" Style="{StaticResource RowLabel}"/>
                                <Slider Grid.Column="1" Minimum="1" Maximum="10" Value="{Binding Thickness}" IsSnapToTickEnabled="True" TickFrequency="1"
                                        Style="{StaticResource RacingSlider}" Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="2" Text="{Binding Thickness, StringFormat={}{0} px}" Style="{StaticResource RowValue}"/>
                            </Grid>

                            <Grid Margin="0,0,0,10" Visibility="{Binding HasArms, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Cross.GapLabel}" Style="{StaticResource RowLabel}"/>
                                <Slider Grid.Column="1" Minimum="0" Maximum="20" Value="{Binding Gap}" IsSnapToTickEnabled="True" TickFrequency="1"
                                        Style="{StaticResource RacingSlider}" Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="2" Text="{Binding Gap, StringFormat={}{0} px}" Style="{StaticResource RowValue}"/>
                            </Grid>

                            <Grid Margin="0,4,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Cross.OutlineLabel}" Style="{StaticResource RowLabel}"/>
                                <CheckBox Grid.Column="1" IsChecked="{Binding Outline}" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <Slider Grid.Column="2" Minimum="1" Maximum="3" Value="{Binding OutlineThickness}" IsSnapToTickEnabled="True" TickFrequency="1"
                                        Style="{StaticResource RacingSlider}" Margin="0,0,12,0"
                                        IsEnabled="{Binding Outline}"/>
                                <TextBlock Grid.Column="3" Text="{Binding OutlineThickness, StringFormat={}{0} px}" Style="{StaticResource RowValue}"/>
                            </Grid>
                        </StackPanel>

                        <!-- Own image -->
                        <StackPanel Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}">
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Cross.ImageLabel}" Style="{StaticResource RowLabel}"/>
                                <Button Grid.Column="1" Content="{DynamicResource Cross.PickImageButton}" Style="{StaticResource Button.Secondary}"
                                        Command="{Binding PickImageCommand}"/>
                                <TextBlock Grid.Column="2" Text="{Binding ImageName}" Style="{StaticResource Text.Telemetry}" Margin="14,0,0,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Cross.ScaleLabel}" Style="{StaticResource RowLabel}"/>
                                <Slider Grid.Column="1" Minimum="10" Maximum="300" Value="{Binding ImageScale}" IsSnapToTickEnabled="True" TickFrequency="5"
                                        Style="{StaticResource RacingSlider}" Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="2" Text="{Binding ImageScale, StringFormat={}{0} %}" Style="{StaticResource RowValue}"/>
                            </Grid>
                        </StackPanel>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Cross.OpacityLabel}" Style="{StaticResource RowLabel}"/>
                            <Slider Grid.Column="1" Minimum="10" Maximum="100" Value="{Binding Opacity}" IsSnapToTickEnabled="True" TickFrequency="5"
                                    Style="{StaticResource RacingSlider}" Margin="0,0,12,0"/>
                            <TextBlock Grid.Column="2" Text="{Binding Opacity, StringFormat={}{0} %}" Style="{StaticResource RowValue}"/>
                        </Grid>

                        <!-- Premium lock, only once the server has said no -->
                        <Border Background="{StaticResource Brush.SurfaceElevated}" BorderBrush="{DynamicResource Brush.AccentMuted}" BorderThickness="1" CornerRadius="6"
                                Padding="16,14" Margin="0,16,0,0" Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource Badge}"><TextBlock Text="PREMIUM" Style="{StaticResource BadgeText}"/></Border>
                                    <TextBlock Text="{DynamicResource Cross.PremiumFeature}" FontFamily="{StaticResource Font.Display}" FontWeight="Black" FontStyle="Italic" Margin="12,0,0,0"
                                               VerticalAlignment="Center" Foreground="{StaticResource Brush.TextPrimary}"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,8,0,0" Text="{DynamicResource FB.PremiumHint}"/>
                                <Button Content="{DynamicResource FB.GoToAccount}" Style="{StaticResource Button.Primary}" HorizontalAlignment="Left"
                                        Margin="0,14,0,0" Command="{Binding OpenAccountCommand}"/>
                            </StackPanel>
                        </Border>

                        <!-- ON / OFF -->
                        <Grid Margin="0,18,0,0" Visibility="{Binding IsLocked, Converter={StaticResource InverseBoolToVis}}">
                            <Button Content="{DynamicResource Cross.TurnOn}" Style="{StaticResource Button.Primary}" Command="{Binding TurnOnCommand}"
                                    HorizontalAlignment="Left" Padding="34,14" FontSize="16"
                                    Visibility="{Binding IsOn, Converter={StaticResource InverseBoolToVis}}"/>
                            <Button Content="{DynamicResource Cross.TurnOff}" Style="{StaticResource Button.Secondary}" Command="{Binding TurnOffCommand}"
                                    HorizontalAlignment="Left" Padding="34,14" FontSize="16"
                                    Visibility="{Binding IsOn, Converter={StaticResource BoolToVis}}"/>
                        </Grid>

                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Caption}" Margin="0,10,0,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource Brush.Warning}" Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}"/>
                    </StackPanel>
                </Border>

                <!-- Preview: three times enlarged, pixel for pixel, over a
                     sky / wall / floor backdrop so the colour can be judged -->
                <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Cross.PreviewLabel}" Style="{StaticResource RowLabel}" Margin="0,0,0,12"/>
                        <Grid Width="252" Height="252" ClipToBounds="True">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Rectangle Grid.Row="0" Fill="#7FA8C9"/>
                            <Rectangle Grid.Row="1" Fill="#8A8178"/>
                            <Rectangle Grid.Row="2" Fill="#3B3530"/>
                            <Image Grid.RowSpan="3" Source="{Binding Preview}" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="{Binding PreviewOpacity}">
                                <Image.LayoutTransform><ScaleTransform ScaleX="3" ScaleY="3"/></Image.LayoutTransform>
                            </Image>
                        </Grid>
                        <TextBlock Text="{DynamicResource Cross.PreviewHint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,10,0,0"/>

                        <Border Margin="0,12,0,0" Padding="12,8" Background="{StaticResource Brush.SurfaceElevated}"
                                Visibility="{Binding IsOn, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" Fill="{StaticResource Brush.Success}" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Cross.Active}" Style="{StaticResource RowLabel}" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- What it is, said plainly -->
            <Border Background="{StaticResource Brush.SurfaceElevated}" BorderBrush="#66F5A623" BorderThickness="1" CornerRadius="6" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Cross.HowTitle}" FontFamily="{StaticResource Font.Display}" FontWeight="Black" FontStyle="Italic" Foreground="{StaticResource Brush.TextPrimary}"/>
                    <TextBlock Style="{StaticResource Point}" Text="{DynamicResource Cross.How1}"/>
                    <TextBlock Style="{StaticResource Point}" Text="{DynamicResource Cross.How2}"/>
                    <TextBlock Style="{StaticResource Point}" Text="{DynamicResource Cross.How3}"/>
                    <TextBlock Style="{StaticResource Point}" Foreground="{StaticResource Brush.Warning}" Text="{DynamicResource Cross.How4}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
