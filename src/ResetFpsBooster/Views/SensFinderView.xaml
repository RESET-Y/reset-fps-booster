<UserControl x:Class="ResetFpsBooster.Views.SensFinderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ResetFpsBooster.ViewModels"
             d:DataContext="{d:DesignInstance vm:SensFinderViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform"><Setter.Value><SkewTransform AngleX="-12"/></Setter.Value></Setter>
        </Style>
        <Style x:Key="BadgeText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Display}"/><Setter Property="FontWeight" Value="Black"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Display}"/><Setter Property="FontWeight" Value="Black"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Point" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
        <Style x:Key="ColumnHead" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="FontFamily" Value="{StaticResource Font.Display}"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="FontStyle" Value="Italic"/>
        </Style>
        <Style x:Key="Cell" TargetType="TextBlock" BasedOn="{StaticResource Text.Telemetry}">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Notice" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Brush.SurfaceElevated}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Warning}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16,12"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,32" MaxWidth="1040" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{DynamicResource Sens.Title}" Style="{StaticResource Text.Title}"/>
                <Border Style="{StaticResource Badge}" Margin="16,6,0,0" VerticalAlignment="Top">
                    <TextBlock Text="NEW" Style="{StaticResource BadgeText}"/>
                </Border>
            </StackPanel>
            <TextBlock Style="{StaticResource Text.Body}" Margin="0,8,0,0" TextWrapping="Wrap" Text="{DynamicResource Sens.Intro}"/>

            <Grid Margin="0,20,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>

                <!-- What is played with -->
                <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Sens.GameLabel}" Style="{StaticResource RowLabel}"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}" DisplayMemberPath="Label"/>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Sens.DpiLabel}" Style="{StaticResource RowLabel}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource Input.TextBox}" Text="{Binding DpiText, UpdateSourceTrigger=PropertyChanged}" MaxLength="5" FontFamily="Consolas"/>
                            <TextBlock Grid.Column="2" Text="{DynamicResource Sens.DpiHint}" Style="{StaticResource Text.Caption}" Margin="14,0,0,0"
                                       VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Sens.SensLabel}" Style="{StaticResource RowLabel}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource Input.TextBox}" Text="{Binding SensText, UpdateSourceTrigger=PropertyChanged}" MaxLength="8" FontFamily="Consolas"/>
                            <TextBlock Grid.Column="2" Text="{Binding SensUnit}" Style="{StaticResource Text.Telemetry}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Sens.FovLabel}" Style="{StaticResource RowLabel}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource Input.TextBox}" Text="{Binding FovText, UpdateSourceTrigger=PropertyChanged}" MaxLength="6" FontFamily="Consolas"/>
                            <TextBlock Grid.Column="2" Text="{Binding FovHint}" Style="{StaticResource Text.Caption}" Margin="14,0,0,0"
                                       VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="86"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="86"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Sens.ResLabel}" Style="{StaticResource RowLabel}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource Input.TextBox}" Text="{Binding ResWidthText, UpdateSourceTrigger=PropertyChanged}" MaxLength="4" FontFamily="Consolas"/>
                            <TextBlock Grid.Column="2" Text="×" Style="{StaticResource Text.Telemetry}" Margin="10,0" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="3" Style="{StaticResource Input.TextBox}" Text="{Binding ResHeightText, UpdateSourceTrigger=PropertyChanged}" MaxLength="4" FontFamily="Consolas"/>
                            <TextBlock Grid.Column="4" Text="{DynamicResource Sens.ResHint}" Style="{StaticResource Text.Caption}" Margin="14,0,0,0"
                                       VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Sens.StretchLabel}" Style="{StaticResource RowLabel}"/>
                            <CheckBox Grid.Column="1" IsChecked="{Binding Stretch}" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{DynamicResource Sens.StretchHint}" Style="{StaticResource Text.Caption}" Margin="14,0,0,0"
                                       VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Sens.EqualsLabel}" Style="{StaticResource RowLabel}"/>
                            <TextBlock Grid.Column="1" Text="{Binding CurrentCm360Text}" Style="{StaticResource Text.Telemetry}"
                                       Foreground="{DynamicResource Brush.AccentBright}" VerticalAlignment="Center"/>
                        </Grid>

                        <Border Style="{StaticResource Notice}" Margin="0,4,0,0" Visibility="{Binding IsArc, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Sens.Calib.Title}" Style="{StaticResource RowLabel}"/>
                                <TextBlock Text="{DynamicResource Sens.Calib.Hint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Sens.Calib.CmLabel}" Style="{StaticResource RowLabel}"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource Input.TextBox}" Text="{Binding CalibrationCm, UpdateSourceTrigger=PropertyChanged}" MaxLength="6" FontFamily="Consolas"/>
                                    <Button Grid.Column="2" Content="{DynamicResource Sens.Calib.Button}" Style="{StaticResource Button.Secondary}" Command="{Binding CalibrateCommand}" Margin="12,0,0,0"/>
                                </Grid>
                                <TextBlock Text="{Binding CalibrationStateText}" Style="{StaticResource Text.Telemetry}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding CalibrationError}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Foreground="{StaticResource Brush.Warning}" Visibility="{Binding CalibrationError, Converter={StaticResource NullToVis}}"/>
                                <Button Content="{DynamicResource Sens.Calib.Reset}" Style="{StaticResource Button.Ghost}" Command="{Binding ResetCalibrationCommand}"
                                        HorizontalAlignment="Left" Margin="0,10,0,0" Visibility="{Binding IsCalibrated, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Border>
                        <Button Content="{DynamicResource Sens.StartTest}" Style="{StaticResource Button.Primary}" Command="{Binding StartTestCommand}"
                                HorizontalAlignment="Left" Padding="34,14" FontSize="16" Margin="0,22,0,0"/>

                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Caption}" Margin="0,10,0,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource Brush.Warning}" Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}"/>
                    </StackPanel>
                </Border>

                <!-- How the test runs, said plainly -->
                <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Sens.HowTitle}" Style="{StaticResource RowLabel}"/>
                        <TextBlock Style="{StaticResource Point}" Text="{DynamicResource Sens.How1}"/>
                        <TextBlock Style="{StaticResource Point}" Text="{DynamicResource Sens.How2}"/>
                        <TextBlock Style="{StaticResource Point}" Text="{DynamicResource Sens.How3}"/>
                        <TextBlock Style="{StaticResource Point}" Foreground="{StaticResource Brush.Warning}" Text="{DynamicResource Sens.How4}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- The result -->
            <Border Style="{StaticResource Card}" Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource Sens.Result.Title}" Style="{StaticResource Text.SectionTitle}"/>
                        <Border Style="{StaticResource Badge}" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ConfidenceText}" Style="{StaticResource BadgeText}"/>
                        </Border>
                    </StackPanel>

                    <TextBlock Text="{DynamicResource Sens.Result.Recommend}" Style="{StaticResource Text.Caption}" Margin="0,16,0,0"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ResultSens}" FontFamily="{StaticResource Font.Display}" FontWeight="Black" FontStyle="Italic"
                                   FontSize="64" Foreground="{DynamicResource Brush.AccentBright}"/>
                        <StackPanel Margin="26,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ResultChange}" Style="{StaticResource RowLabel}" FontSize="16"/>
                            <TextBlock Text="{Binding ResultCm360}" Style="{StaticResource Text.Telemetry}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{Binding ResultRange}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,6,0,0"/>

                    <Border Style="{StaticResource Notice}" Margin="0,16,0,0" Visibility="{Binding ResultNotice, Converter={StaticResource NullToVis}}">
                        <TextBlock Text="{Binding ResultNotice}" Style="{StaticResource Text.Body}" TextWrapping="Wrap"/>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="{DynamicResource Sens.Result.UseButton}" Style="{StaticResource Button.Secondary}" Command="{Binding UseResultCommand}"/>
                        <TextBlock Text="{Binding UsedMessage}" Style="{StaticResource Text.Caption}" Margin="14,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource Brush.Success}" Visibility="{Binding UsedMessage, Converter={StaticResource NullToVis}}"/>
                    </StackPanel>

                    <!-- Every round -->
                    <TextBlock Text="{DynamicResource Sens.Result.Rounds}" Style="{StaticResource RowLabel}" Margin="0,26,0,10"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Sens.Col.Sens}" Style="{StaticResource ColumnHead}"/>
                        <TextBlock Grid.Column="1" Text="{DynamicResource Sens.Col.Score}" Style="{StaticResource ColumnHead}"/>
                        <TextBlock Grid.Column="2" Text="{DynamicResource Sens.Col.Hits}" Style="{StaticResource ColumnHead}"/>
                        <TextBlock Grid.Column="3" Text="{DynamicResource Sens.Col.Time}" Style="{StaticResource ColumnHead}"/>
                        <TextBlock Grid.Column="4" Text="{DynamicResource Sens.Col.Track}" Style="{StaticResource ColumnHead}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Rounds}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Sens}" Style="{StaticResource Cell}"/>
                                    <Grid Grid.Column="1" Height="12" Margin="0,0,24,0" VerticalAlignment="Center">
                                        <Rectangle Fill="{StaticResource Brush.SurfaceElevated}"/>
                                        <Rectangle x:Name="Bar" Fill="{StaticResource Brush.TextTertiary}" RenderTransformOrigin="0,0.5">
                                            <Rectangle.RenderTransform>
                                                <ScaleTransform ScaleX="{Binding ScoreBar}"/>
                                            </Rectangle.RenderTransform>
                                        </Rectangle>
                                    </Grid>
                                    <TextBlock Grid.Column="2" Text="{Binding Hits}" Style="{StaticResource Cell}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Time}" Style="{StaticResource Cell}"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Track}" Style="{StaticResource Cell}"/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsTop}" Value="True">
                                        <Setter TargetName="Bar" Property="Fill" Value="{DynamicResource Brush.Accent}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- The same turn elsewhere -->
                    <TextBlock Text="{DynamicResource Sens.Result.AllGames}" Style="{StaticResource RowLabel}" Margin="0,22,0,10"/>
                    <ItemsControl ItemsSource="{Binding OtherGames}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Brush.SurfaceElevated}" Padding="16,10" Margin="0,0,12,12" MinWidth="170">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Game}" Style="{StaticResource Text.Caption}"/>
                                        <TextBlock Text="{Binding Value}" Style="{StaticResource RowLabel}" FontSize="24" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource Brush.AccentBright}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding GameNote}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,0"
                               Visibility="{Binding GameNote, Converter={StaticResource NullToVis}}"/>

                    <TextBlock Text="{DynamicResource Sens.Result.Honest}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,16,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
