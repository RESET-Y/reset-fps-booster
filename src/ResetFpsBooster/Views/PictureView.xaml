<UserControl x:Class="ResetFpsBooster.Views.PictureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ResetFpsBooster.ViewModels"
             d:DataContext="{d:DesignInstance vm:PictureViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform"><Setter.Value><SkewTransform AngleX="-12"/></Setter.Value></Setter>
        </Style>
        <Style x:Key="BadgeText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Display}"/><Setter Property="FontWeight" Value="Black"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Display}"/><Setter Property="FontWeight" Value="Black"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Point" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
        <Style x:Key="Notice" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Brush.SurfaceElevated}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Warning}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16,12"/>
        </Style>
        <!-- A preset button; the one the picture comes from gets an accent frame -->
        <Style x:Key="PresetFrame" TargetType="Border">
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,32" MaxWidth="1040" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{DynamicResource Picture.Title}" Style="{StaticResource Text.Title}"/>
                <Border Style="{StaticResource Badge}" Margin="16,6,0,0" VerticalAlignment="Top">
                    <TextBlock Text="NEW" Style="{StaticResource BadgeText}"/>
                </Border>
            </StackPanel>
            <TextBlock Style="{StaticResource Text.Body}" Margin="0,8,0,0" TextWrapping="Wrap" Text="{DynamicResource Picture.Intro}"/>

            <!-- No NVIDIA driver: saturation is missing, the rest works -->
            <Border Style="{StaticResource Notice}" Margin="0,16,0,0" Visibility="{Binding SaturationAvailable, Converter={StaticResource InverseBoolToVis}}">
                <TextBlock Text="{DynamicResource Picture.Status.NoDriver}" Style="{StaticResource Text.Body}" TextWrapping="Wrap"/>
            </Border>

            <Grid Margin="0,20,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <!-- Presets -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Picture.Presets}" Style="{StaticResource RowLabel}" FontSize="16" Margin="0,0,0,14"/>
                            <ItemsControl ItemsSource="{Binding PresetItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource PresetFrame}">
                                            <Button Content="{Binding Preset.Name}" Style="{StaticResource Button.Secondary}" Padding="16,10"
                                                    Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Preset}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- The three sliders -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Picture.Saturation}" Style="{StaticResource RowLabel}"/>
                                <Slider Grid.Column="1" Minimum="-100" Maximum="100" Value="{Binding Saturation}" IsSnapToTickEnabled="True" TickFrequency="1"
                                        Style="{StaticResource RacingSlider}" IsEnabled="{Binding SaturationAvailable}" Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="2" Text="{Binding Saturation, StringFormat={}{0:+0;-0;0}}" Style="{StaticResource Text.Telemetry}" TextAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Picture.Brightness}" Style="{StaticResource RowLabel}"/>
                                <Slider Grid.Column="1" Minimum="-100" Maximum="100" Value="{Binding Brightness}" IsSnapToTickEnabled="True" TickFrequency="1"
                                        Style="{StaticResource RacingSlider}" Margin="0,0,12,0" IsEnabled="{Binding GammaAvailable}"/>
                                <TextBlock Grid.Column="2" Text="{Binding Brightness, StringFormat={}{0:+0;-0;0}}" Style="{StaticResource Text.Telemetry}" TextAlignment="Right"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Picture.Contrast}" Style="{StaticResource RowLabel}"/>
                                <Slider Grid.Column="1" Minimum="-100" Maximum="100" Value="{Binding Contrast}" IsSnapToTickEnabled="True" TickFrequency="1"
                                        Style="{StaticResource RacingSlider}" Margin="0,0,12,0" IsEnabled="{Binding GammaAvailable}"/>
                                <TextBlock Grid.Column="2" Text="{Binding Contrast, StringFormat={}{0:+0;-0;0}}" Style="{StaticResource Text.Telemetry}" TextAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Own presets -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Picture.OwnPresets}" Style="{StaticResource RowLabel}" FontSize="16" Margin="0,0,0,14"/>
                            <ItemsControl ItemsSource="{Binding CustomItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource PresetFrame}" Margin="0">
                                                <Button Content="{Binding Preset.Name}" Style="{StaticResource Button.Secondary}" Padding="16,10" HorizontalAlignment="Left"
                                                        Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Preset}"/>
                                            </Border>
                                            <Button Grid.Column="1" Content="{DynamicResource Picture.Delete}" Style="{StaticResource Button.Ghost}" Margin="12,0,0,0"
                                                    Command="{Binding DataContext.DeletePresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Preset}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Style="{StaticResource Input.TextBox}" Text="{Binding NewPresetName, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{DynamicResource Picture.NameHint}" MaxLength="30" Margin="0,0,12,0"/>
                                <Button Grid.Column="1" Content="{DynamicResource Picture.SaveAs}" Style="{StaticResource Button.Secondary}"
                                        Command="{Binding SavePresetCommand}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Auto-off, the programs that pause it, and the status -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding AutoOff}" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Top" Margin="0,2,16,0"/>
                                <TextBlock Grid.Column="1" Text="{DynamicResource Picture.AutoOff}" Style="{StaticResource RowLabel}" TextWrapping="Wrap"/>
                            </Grid>
                            <TextBlock Text="{DynamicResource Picture.AutoOffHint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,8,0,0"/>

                            <TextBlock Text="{DynamicResource Picture.GamesTitle}" Style="{StaticResource RowLabel}" Margin="0,18,0,8"/>
                            <ItemsControl ItemsSource="{Binding Games}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Pauses}" Content="{Binding Name}" Foreground="{StaticResource Brush.TextPrimary}" Margin="0,0,0,8"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{DynamicResource Picture.NoGames}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                       Visibility="{Binding HasGames, Converter={StaticResource InverseBoolToVis}}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding PictureStatus}" Style="{StaticResource Text.Body}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding MessageText}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,10,0,0"
                                       Foreground="{StaticResource Brush.Warning}" Visibility="{Binding MessageText, Converter={StaticResource NullToVis}}"/>
                            <Button Content="{DynamicResource Picture.Reset}" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left"
                                    Command="{Binding ResetCommand}" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Notice}" Margin="0,16,0,0">
                        <TextBlock Style="{StaticResource Point}" TextWrapping="Wrap" Text="{DynamicResource Picture.How}"/>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
