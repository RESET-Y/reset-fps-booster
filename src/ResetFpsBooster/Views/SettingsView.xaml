<UserControl x:Class="ResetFpsBooster.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ResetFpsBooster.ViewModels"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,32" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="{DynamicResource Settings.Title}" Style="{StaticResource Text.Title}"/>
            <TextBlock Text="{DynamicResource Settings.Subtitle}" Style="{StaticResource Text.Body}" Margin="0,4,0,24"/>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings.General}" Style="{StaticResource Text.SectionTitle}"/>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Settings.Language}" Foreground="{StaticResource Brush.TextPrimary}" FontSize="13.5"/>
                            <TextBlock Text="{DynamicResource Settings.LanguageHint}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" Width="140" VerticalAlignment="Center"
                                  ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                                  DisplayMemberPath="NativeName"/>
                    </Grid>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Settings.StartWithWindows}" Foreground="{StaticResource Brush.TextPrimary}" FontSize="13.5"/>
                            <TextBlock Text="{DynamicResource Settings.StartWithWindowsHint}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartWithWindows}"/>
                    </Grid>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Settings.LaunchElevated}" Foreground="{StaticResource Brush.TextPrimary}" FontSize="13.5"/>
                            <TextBlock Text="{DynamicResource Settings.LaunchElevatedHint}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartWithWindowsAsAdmin}"/>
                    </Grid>
                    <TextBlock Text="{Binding StartupModeMessage}" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Success}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Visibility="{Binding StartupModeMessage, Converter={StaticResource NullToVis}}"/>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Settings.Toasts}" Foreground="{StaticResource Brush.TextPrimary}" FontSize="13.5"/>
                            <TextBlock Text="{DynamicResource Settings.ToastsHint}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.ShowToastNotifications}"/>
                    </Grid>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Settings.Confirm}" Foreground="{StaticResource Brush.TextPrimary}" FontSize="13.5"/>
                            <TextBlock Text="{DynamicResource Settings.ConfirmHint}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.ConfirmBeforeApplyingChanges}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings.Optimization}" Style="{StaticResource Text.SectionTitle}"/>
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Settings.Experimental}" Foreground="{StaticResource Brush.TextPrimary}" FontSize="13.5"/>
                            <TextBlock Text="{DynamicResource Settings.ExperimentalHint}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.EnableExperimentalOptimizations}"/>
                    </Grid>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Settings.GameBoost}" Foreground="{StaticResource Brush.TextPrimary}" FontSize="13.5"/>
                            <TextBlock Text="{DynamicResource Settings.GameBoostHint}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding EnableGameBoost}" VerticalAlignment="Top"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings.Appearance}" Style="{StaticResource Text.SectionTitle}"/>
                    <TextBlock Text="{DynamicResource Settings.AccentColor}" Style="{StaticResource Text.Caption}" Margin="0,16,0,8"/>

                    <ItemsControl ItemsSource="{Binding AccentPresets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="36" Height="36" Margin="0,0,10,10" Padding="0"
                                        Command="{Binding DataContext.SelectAccentColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Hex}"
                                        ToolTip="{Binding Name}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="2" Background="{Binding Swatch}"
                                                    BorderThickness="2" BorderBrush="{StaticResource Brush.Border}"/>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{DynamicResource Settings.AppliedOnRestart}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0"/>
                    <Button Content="{DynamicResource Settings.RestartNow}" Style="{StaticResource Button.Secondary}" HorizontalAlignment="Left" Margin="0,10,0,0"
                            Command="{Binding RestartAppCommand}"
                            Visibility="{Binding AccentColorChanged, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings.AdminAccess}" Style="{StaticResource Text.SectionTitle}"/>
                    <TextBlock Margin="0,10,0,0" Style="{StaticResource Text.Body}">
                        <Run Text="{DynamicResource Settings.CurrentStatus}"/><Run Text="{Binding IsAdministrator, Mode=OneWay, Converter={StaticResource BoolToYesNo}}" Foreground="{StaticResource Brush.TextPrimary}" FontFamily="Segoe UI Semibold"/>
                    </TextBlock>
                    <Button Content="{DynamicResource Settings.RestartAsAdmin}" Style="{StaticResource Button.Secondary}" HorizontalAlignment="Left" Margin="0,12,0,0"
                            Command="{Binding RelaunchElevatedCommand}"
                            Visibility="{Binding IsAdministrator, Converter={StaticResource InverseBoolToVis}}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings.Updates}" Style="{StaticResource Text.SectionTitle}"/>

                    <TextBlock Text="{DynamicResource Settings.UpdateRepo}" Style="{StaticResource Text.Caption}" Margin="0,16,0,6"/>
                    <TextBox Text="{Binding UpdateRepositoryInput, UpdateSourceTrigger=LostFocus}"
                             Background="{StaticResource Brush.SurfaceHover}" Foreground="{StaticResource Brush.TextPrimary}"
                             BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" Padding="10,8"
                             FontFamily="Consolas" FontSize="12.5"/>
                    <TextBlock Text="{DynamicResource Settings.UpdateRepoHint}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0" TextWrapping="Wrap"/>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Settings.AutoCheck}" Foreground="{StaticResource Brush.TextPrimary}" FontSize="13.5"/>
                            <TextBlock Text="{DynamicResource Settings.AutoCheckHint}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.AutoCheckForUpdates}"/>
                    </Grid>

                    <Button Content="{DynamicResource Settings.CheckForUpdates}" Style="{StaticResource Button.Secondary}" HorizontalAlignment="Left" Margin="0,18,0,0"
                            Command="{Binding CheckForUpdatesCommand}" IsEnabled="{Binding IsCheckingForUpdate, Converter={StaticResource InverseBool}}"/>

                    <TextBlock Text="{Binding UpdateStatusMessage}" Style="{StaticResource Text.Body}" Margin="0,10,0,0"
                               Visibility="{Binding UpdateStatusMessage, Converter={StaticResource NullToVis}}"/>

                    <StackPanel Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}" Margin="0,14,0,0">
                        <Border Background="{StaticResource Brush.SurfaceElevated}" CornerRadius="2" Padding="14" BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1,0,0,0">
                            <StackPanel>
                                <TextBlock FontFamily="Segoe UI Semibold" Foreground="{DynamicResource Brush.AccentBright}" FontSize="13">
                                    <Run Text="{DynamicResource Settings.VersionPrefix}"/><Run Text="{Binding LatestVersionText, Mode=OneWay}"/><Run Text="{DynamicResource Settings.VersionSuffix}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding ReleaseNotes}" Style="{StaticResource Text.Body}" Margin="0,8,0,0" MaxHeight="120"
                                           Visibility="{Binding ReleaseNotes, Converter={StaticResource NullToVis}}"/>

                                <ProgressBar Style="{StaticResource ProgressBar.Accent}" Minimum="0" Maximum="100" Value="{Binding DownloadProgressPercent, Mode=OneWay}"
                                             Margin="0,12,0,0" Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BoolToVis}}"/>

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="{DynamicResource Settings.Download}"
                                            Command="{Binding DownloadAndInstallUpdateCommand}"
                                            IsEnabled="{Binding IsDownloadingUpdate, Converter={StaticResource InverseBool}}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource Button.Primary}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding PendingInstallerPath}" Value="{x:Null}"/>
                                                            <Condition Binding="{Binding HasDownloadUrl}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="{DynamicResource Settings.InstallRestart}" Style="{StaticResource Button.Primary}"
                                            Command="{Binding InstallDownloadedUpdateCommand}"
                                            Visibility="{Binding PendingInstallerPath, Converter={StaticResource NullToVis}}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings.About}" Style="{StaticResource Text.SectionTitle}"/>
                    <Image Source="/Assets/logo_wide.png" Height="40" HorizontalAlignment="Left" Stretch="Uniform" Margin="0,16,0,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="{Binding Source={x:Static vm:SettingsViewModel.AppVersion}, StringFormat='Version {0}'}" Style="{StaticResource Text.Caption}" Margin="0,10,0,0"/>
                    <TextBlock Text="{DynamicResource Settings.MadeByLukas}" Style="{StaticResource Text.Body}" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
