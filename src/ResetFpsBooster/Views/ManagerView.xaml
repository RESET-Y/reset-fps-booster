<UserControl x:Class="ResetFpsBooster.Views.ManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ResetFpsBooster.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ManagerViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,32" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="{DynamicResource Manager.Title}" Style="{StaticResource Text.Title}"/>
            <TextBlock Text="{DynamicResource Manager.Intro}" Style="{StaticResource Text.Body}" Margin="0,8,0,0" TextWrapping="Wrap"/>

            <!-- Create -->
            <Border Style="{StaticResource Card}" Margin="0,20,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Manager.NewCode}" Style="{StaticResource Text.SectionTitle}"/>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Manager.Duration}" Style="{StaticResource Text.Caption}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding Durations}" SelectedItem="{Binding SelectedDuration}"
                                      DisplayMemberPath="Label" Width="140"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource Manager.MaxUses}" Style="{StaticResource Text.Caption}" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Text="{Binding MaxUses, UpdateSourceTrigger=PropertyChanged}" Width="60" Padding="8,5"/>
                                <TextBlock Text="{DynamicResource Manager.Times}" Style="{StaticResource Text.Caption}"
                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{DynamicResource Manager.Note}" Style="{StaticResource Text.Caption}" Margin="0,14,0,4"/>
                    <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" MaxWidth="420" HorizontalAlignment="Left" Width="420"/>

                    <Button Content="{DynamicResource Manager.Create}" Style="{StaticResource Button.Primary}" HorizontalAlignment="Left"
                            Margin="0,16,0,0" Command="{Binding CreateCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>

                    <!-- The code just made, large enough to read out. -->
                    <StackPanel Margin="0,16,0,0" Visibility="{Binding LastCreatedCode, Converter={StaticResource NullToVis}}">
                        <TextBlock Text="{DynamicResource Manager.Created}" Style="{StaticResource Text.Caption}"/>
                        <TextBox Text="{Binding LastCreatedCode, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="22"
                                 Foreground="{StaticResource Brush.AccentBright}" Background="Transparent" BorderThickness="0"
                                 Margin="0,4,0,0"/>
                    </StackPanel>

                    <TextBlock Text="{Binding Message}" Foreground="{StaticResource Brush.Warning}" Style="{StaticResource Text.Caption}"
                               Margin="0,10,0,0" Visibility="{Binding Message, Converter={StaticResource NullToVis}}"/>
                </StackPanel>
            </Border>

            <!-- List -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{DynamicResource Manager.Codes}" Style="{StaticResource Text.SectionTitle}"/>
                        <Button Content="{DynamicResource Manager.Refresh}" Style="{StaticResource Button.Secondary}"
                                HorizontalAlignment="Right" Command="{Binding RefreshCommand}"/>
                    </Grid>

                    <TextBlock Text="{DynamicResource Manager.NoCodes}" Style="{StaticResource Text.Caption}" Margin="0,14,0,0"
                               Visibility="{Binding HasNoCodes, Converter={StaticResource BoolToVis}}"/>

                    <ItemsControl ItemsSource="{Binding Codes}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Brush.BorderSubtle}" BorderThickness="0,0,0,1" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Code}" FontFamily="Consolas" FontSize="15"
                                                       Foreground="{StaticResource Brush.TextPrimary}"/>
                                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,0">
                                                <Run Text="{Binding Duration, Mode=OneWay}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding Usage, Mode=OneWay}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding Created, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Note}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0"
                                                       Visibility="{Binding Note, Converter={StaticResource NullToVis}}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="{DynamicResource Manager.Copy}" Style="{StaticResource Button.Secondary}"
                                                    Command="{Binding CopyCommand}"/>
                                            <Button Content="{Binding ToggleLabel}" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0"
                                                    Command="{Binding ToggleCommand}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
