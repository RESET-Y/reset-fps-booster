<UserControl x:Class="ResetFpsBooster.Views.ApexConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ResetFpsBooster.ViewModels"
             d:DataContext="{d:DesignInstance vm:ApexConfigViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform"><Setter.Value><SkewTransform AngleX="-12"/></Setter.Value></Setter>
        </Style>
        <Style x:Key="BadgeText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Display}"/><Setter Property="FontWeight" Value="Black"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Display}"/><Setter Property="FontWeight" Value="Black"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Point" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
        <Style x:Key="Notice" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Brush.SurfaceElevated}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Warning}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16,12"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,32" MaxWidth="1040" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{DynamicResource Apex.Title}" Style="{StaticResource Text.Title}"/>
                <Border Style="{StaticResource Badge}" Margin="16,6,0,0" VerticalAlignment="Top">
                    <TextBlock Text="NEW" Style="{StaticResource BadgeText}"/>
                </Border>
            </StackPanel>
            <TextBlock Style="{StaticResource Text.Body}" Margin="0,8,0,0" TextWrapping="Wrap" Text="{DynamicResource Apex.Intro}"/>

            <!-- The files were not found, or the game is running: nothing can be written yet -->
            <Border Style="{StaticResource Notice}" Margin="0,16,0,0"
                    Visibility="{Binding Found, Converter={StaticResource InverseBoolToVis}}">
                <TextBlock Text="{Binding NotFoundText}" Style="{StaticResource Text.Body}" TextWrapping="Wrap"/>
            </Border>
            <Border Style="{StaticResource Notice}" Margin="0,16,0,0"
                    Visibility="{Binding GameRunning, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{DynamicResource Apex.GameRunning}" Style="{StaticResource Text.Body}" TextWrapping="Wrap"/>
            </Border>

            <Grid Margin="0,20,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <!-- Where the settings are kept -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Apex.TargetLabel}" Style="{StaticResource RowLabel}"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}" DisplayMemberPath="Label"/>
                        </Grid>
                        <StackPanel Margin="0,0,0,18" Visibility="{Binding IsAutoexec, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding AutoexecPathText}" Style="{StaticResource Text.Telemetry}" TextWrapping="Wrap"/>
                            <TextBlock Text="{DynamicResource Apex.AutoexecNote}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>

                        <!-- Graphics -->
                        <TextBlock Text="{DynamicResource Apex.GraphicsTitle}" Style="{StaticResource RowLabel}" FontSize="16" Margin="0,0,0,12"/>
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsEnabled}" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Top" Margin="0,2,16,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource RowLabel}" VerticalAlignment="Top"/>
                                            <TextBlock Text="{Binding Hint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding Note}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                       Foreground="{StaticResource Brush.Warning}" Visibility="{Binding Note, Converter={StaticResource NullToVis}}"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Style="{StaticResource Badge}" Margin="12,2,0,0" VerticalAlignment="Top"
                                                Background="{StaticResource Brush.SurfaceElevated}"
                                                Visibility="{Binding Already, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding AlreadyText}" Style="{StaticResource BadgeText}" Foreground="{DynamicResource Brush.AccentBright}"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Texture streaming -->
                        <TextBlock Text="{DynamicResource Apex.StreamTitle}" Style="{StaticResource RowLabel}" FontSize="16" Margin="0,12,0,4"/>
                        <TextBlock Text="{DynamicResource Apex.StreamHint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"/>
                        <ComboBox Margin="0,10,0,0" ItemsSource="{Binding Streams}" SelectedItem="{Binding SelectedStream}" DisplayMemberPath="Label"/>
                        <TextBlock Text="{Binding StreamNow}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0"/>
                        <Border Style="{StaticResource Notice}" Margin="0,12,0,0" Visibility="{Binding StreamWarnLowText, Converter={StaticResource NullToVis}}">
                            <TextBlock Text="{Binding StreamWarnLowText}" Style="{StaticResource Text.Body}" TextWrapping="Wrap"/>
                        </Border>
                        <Border Style="{StaticResource Notice}" Margin="0,12,0,0" Visibility="{Binding StreamWarnOverrideText, Converter={StaticResource NullToVis}}">
                            <TextBlock Text="{Binding StreamWarnOverrideText}" Style="{StaticResource Text.Body}" TextWrapping="Wrap"/>
                        </Border>

                        <!-- Field of view -->
                        <TextBlock Text="{DynamicResource Apex.FovTitle}" Style="{StaticResource RowLabel}" FontSize="16" Margin="0,24,0,4"/>
                        <TextBlock Text="{Binding FovHintText}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider Minimum="70" Maximum="120" Value="{Binding Fov}" IsSnapToTickEnabled="True" TickFrequency="1"
                                    Style="{StaticResource RacingSlider}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding FovReadout}" Style="{StaticResource Text.Telemetry}"
                                       Foreground="{DynamicResource Brush.AccentBright}" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="{Binding FovNow}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0"/>
                        <Border Style="{StaticResource Notice}" Margin="0,12,0,0"
                                Visibility="{Binding FovAboveMenu, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{DynamicResource Apex.FovWarning}" Style="{StaticResource Text.Body}" TextWrapping="Wrap"/>
                        </Border>

                        <!-- Optional write protection (settings files only): starts from what the file has now, never set by the app on its own -->
                        <Grid Margin="0,22,0,0" Visibility="{Binding IsSettingsFiles, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{Binding LockReadOnly}" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Top" Margin="0,2,16,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{DynamicResource Apex.Lock}" Style="{StaticResource RowLabel}" VerticalAlignment="Top"/>
                                <TextBlock Text="{DynamicResource Apex.LockHint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                            <Button Content="{DynamicResource Apex.ApplyButton}" Style="{StaticResource Button.Primary}" Command="{Binding ApplyCommand}"
                                    Padding="34,14" FontSize="16" IsEnabled="{Binding Found}"/>
                            <Button Content="{DynamicResource Apex.RestoreButton}" Style="{StaticResource Button.Secondary}" Command="{Binding RestoreCommand}"
                                    Margin="14,0,0,0" IsEnabled="{Binding HasSnapshot}"/>
                        </StackPanel>

                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Caption}" Margin="0,12,0,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource Brush.Warning}" Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}"/>
                        <TextBlock Text="{Binding OkMessage}" Style="{StaticResource Text.Caption}" Margin="0,12,0,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource Brush.Success}" Visibility="{Binding OkMessage, Converter={StaticResource NullToVis}}"/>
                    </StackPanel>
                </Border>

                <!-- How it works, said plainly -->
                <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Apex.HowTitle}" Style="{StaticResource RowLabel}"/>
                        <TextBlock Style="{StaticResource Point}" Text="{DynamicResource Apex.How1}"
                                   Visibility="{Binding IsSettingsFiles, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Style="{StaticResource Point}" Text="{DynamicResource Apex.AutoHow1}"
                                   Visibility="{Binding IsAutoexec, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Style="{StaticResource Point}" Text="{DynamicResource Apex.How2}"/>
                        <TextBlock Style="{StaticResource Point}" Text="{DynamicResource Apex.How3}"
                                   Visibility="{Binding IsSettingsFiles, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Style="{StaticResource Point}" Text="{DynamicResource Apex.AutoHow3}"
                                   Visibility="{Binding IsAutoexec, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Style="{StaticResource Point}" Foreground="{StaticResource Brush.Warning}" Text="{DynamicResource Apex.How4}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
