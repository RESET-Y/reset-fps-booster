<UserControl x:Class="ResetFpsBooster.Views.AccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ResetFpsBooster.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:AccountViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,32" MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock Text="{DynamicResource Account.Title}" Style="{StaticResource Text.Title}"/>
            <TextBlock Style="{StaticResource Text.Body}" Margin="0,8,0,0" TextWrapping="Wrap"
                       Text="{DynamicResource Account.Intro}"/>

            <!-- Shown in a build that has no backend configured yet, instead of
                 a form that fails on every click. -->
            <Border Style="{StaticResource Card}" Margin="0,20,0,0"
                    Visibility="{Binding IsConfigured, Converter={StaticResource InverseBoolToVis}}">
                <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap"
                           Text="{DynamicResource Account.NotAvailable}"/>
            </Border>

            <StackPanel Visibility="{Binding IsConfigured, Converter={StaticResource BoolToVis}}">

                <!-- Signed out -->
                <Border Style="{StaticResource Card}" Margin="0,20,0,0"
                        Visibility="{Binding IsSignedOut, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Account.SignInTitle}" Style="{StaticResource Text.SectionTitle}"/>

                        <TextBlock Text="{DynamicResource Account.Email}" Style="{StaticResource Text.Caption}" Margin="0,16,0,4"/>
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"/>

                        <TextBlock Text="{DynamicResource Account.Password}" Style="{StaticResource Text.Caption}" Margin="0,12,0,4"/>
                        <PasswordBox x:Name="PasswordInput" Padding="8,6"/>

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Content="{DynamicResource Account.SignIn}" Style="{StaticResource Button.Primary}"
                                    Command="{Binding SignInCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
                            <Button Content="{DynamicResource Account.CreateAccount}" Style="{StaticResource Button.Secondary}" Margin="10,0,0,0"
                                    Command="{Binding SignUpCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Signed in -->
                <Border Style="{StaticResource Card}" Margin="0,20,0,0"
                        Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Account.SignedIn}" Style="{StaticResource Text.SectionTitle}"/>
                        <TextBlock Text="{Binding SignedInEmail}" Style="{StaticResource Text.Body}" Margin="0,8,0,0"/>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Border CornerRadius="3" Padding="8,3" Background="{StaticResource Brush.Success}"
                                    Visibility="{Binding IsPremium, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="PREMIUM" FontFamily="Segoe UI Semibold" FontSize="11" Foreground="White"/>
                            </Border>
                            <TextBlock Text="{Binding PremiumUntilText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="10,0,0,0"
                                       Visibility="{Binding IsPremium, Converter={StaticResource BoolToVis}}"/>
                            <Border CornerRadius="3" Padding="8,3" Background="{StaticResource Brush.SurfaceElevated}"
                                    Visibility="{Binding IsPremium, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Text="FREE" FontFamily="Segoe UI Semibold" FontSize="11"
                                           Foreground="{StaticResource Brush.TextSecondary}"/>
                            </Border>
                        </StackPanel>

                        <!-- Buying: only for a signed-in user without premium. -->
                        <Border Background="{StaticResource Brush.SurfaceElevated}" CornerRadius="6" Padding="14,12" Margin="0,18,0,0"
                                Visibility="{Binding CanUpgrade, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Account.UpgradeTitle}" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextPrimary}"/>
                                <TextBlock Text="{DynamicResource Account.UpgradeHint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                                            Visibility="{Binding StoreOpen, Converter={StaticResource BoolToVis}}">
                                    <Button Content="{DynamicResource Account.BuyMonthly}" Style="{StaticResource Button.Primary}" Command="{Binding BuyMonthlyCommand}"/>
                                    <Button Content="{DynamicResource Account.BuyLifetime}" Style="{StaticResource Button.Primary}" Margin="10,0,0,0" Command="{Binding BuyLifetimeCommand}"/>
                                </StackPanel>
                                <TextBlock Text="{DynamicResource Account.StoreSoon}" Style="{StaticResource Text.Caption}" Margin="0,10,0,0"
                                           Visibility="{Binding StoreOpen, Converter={StaticResource InverseBoolToVis}}"/>
                                <Button Content="{DynamicResource Account.CheckAgain}" Style="{StaticResource Button.Secondary}" HorizontalAlignment="Left"
                                        Margin="0,10,0,0" Command="{Binding CheckAgainCommand}"
                                        Visibility="{Binding StoreOpen, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Border>

                        <!-- Redeeming a code: open to every signed-in user. -->
                        <StackPanel Margin="0,18,0,0">
                            <TextBlock Text="{DynamicResource Account.RedeemTitle}" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextPrimary}"/>
                            <TextBlock Text="{DynamicResource Account.RedeemHint}" Style="{StaticResource Text.Caption}" Margin="0,2,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Text="{Binding RedeemCode, UpdateSourceTrigger=PropertyChanged}" Width="220" Padding="8,6"
                                         FontFamily="Consolas" CharacterCasing="Upper"/>
                                <Button Content="{DynamicResource Account.RedeemButton}" Style="{StaticResource Button.Secondary}" Margin="10,0,0,0"
                                        Command="{Binding RedeemCommand}"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
                            </StackPanel>
                        </StackPanel>

                        <Button Content="{DynamicResource Account.SignOut}" Style="{StaticResource Button.Secondary}"
                                HorizontalAlignment="Left" Margin="0,18,0,0"
                                Command="{Binding SignOutCommand}"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Caption}" Margin="0,12,0,0" TextWrapping="Wrap"
                           Visibility="{Binding Message, Converter={StaticResource NullToVis}}">
                    <TextBlock.Foreground>
                        <SolidColorBrush Color="#FFD27A"/>
                    </TextBlock.Foreground>
                </TextBlock>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
