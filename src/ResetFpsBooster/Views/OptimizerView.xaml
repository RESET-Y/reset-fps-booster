<UserControl x:Class="ResetFpsBooster.Views.OptimizerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ResetFpsBooster.ViewModels"
             d:DataContext="{d:DesignInstance vm:OptimizerViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">
    <Grid Margin="36,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Optimizer" Style="{StaticResource Text.Title}"/>
            <TextBlock Text="Review exactly what will change, then apply it. Every change is backed up and can be undone from Backups." Style="{StaticResource Text.Body}" Margin="0,4,0,20"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock FontFamily="Segoe UI Semibold" FontSize="16" Foreground="{StaticResource Brush.TextPrimary}">
                        <Run Text="{Binding SelectedCount, Mode=OneWay}"/><Run Text=" optimization(s) selected"/>
                    </TextBlock>
                    <TextBlock Text="Includes an irreversible step (temp file cleanup) — review before applying." Style="{StaticResource Text.Caption}" Margin="0,4,0,0"
                               Visibility="{Binding HasIrreversibleSelection, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding SummaryMessage}" Style="{StaticResource Text.Body}" Margin="0,8,0,0"
                               Visibility="{Binding SummaryMessage, Converter={StaticResource NullToVis}}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding IsApplying, Converter={StaticResource BoolToVis}}">
                        <ProgressBar Style="{StaticResource ProgressBar.Accent}" Width="220" Minimum="0" Maximum="{Binding ProgressTotal}" Value="{Binding ProgressCurrent, Mode=OneWay}"/>
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="10,0,0,0" VerticalAlignment="Center">
                            <Run Text="{Binding ProgressCurrent, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding ProgressTotal, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                    <Border Background="{StaticResource Brush.SurfaceElevated}" CornerRadius="8" Padding="12,8" Margin="0,10,0,0"
                            Visibility="{Binding NeedsAdminPrompt, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="This optimization requires administrator privileges." FontFamily="Segoe UI Semibold" Foreground="{StaticResource Brush.Warning}" FontSize="12.5"/>
                            <Button Content="Restart as Administrator" Style="{StaticResource Button.Secondary}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                    Command="{Binding RelaunchElevatedCommand}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource Brush.SurfaceElevated}" CornerRadius="8" Padding="12,8" Margin="0,10,0,0"
                            Visibility="{Binding AnyResultRequiresReboot, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Restart your PC for all applied changes to take full effect." FontFamily="Segoe UI Semibold" Foreground="{StaticResource Brush.Cyan}" FontSize="12.5"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Select None" Style="{StaticResource Button.Ghost}" Command="{Binding SelectNoneCommand}" Margin="0,0,8,0"/>
                    <Button Content="Select Recommended" Style="{StaticResource Button.Secondary}" Command="{Binding SelectRecommendedCommand}" Margin="0,0,8,0"/>
                    <Button Content="OPTIMIZE NOW" Style="{StaticResource Button.Primary}" Command="{Binding ApplySelectedCommand}" FontSize="15" Padding="28,14"
                            IsEnabled="{Binding IsApplying, Converter={StaticResource InverseBool}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Modules}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:OptimizationModuleViewModel}">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" Style="{StaticResource CardCheckBox}" IsChecked="{Binding IsSelected}"
                                          IsEnabled="{Binding IsAvailable}" VerticalAlignment="Top" Margin="0,2,16,0"/>

                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontFamily="Segoe UI Semibold" FontSize="14.5" Foreground="{StaticResource Brush.TextPrimary}"/>
                                        <Border Background="{Binding Risk, Converter={StaticResource RiskToBrush}}" CornerRadius="8" Padding="8,2" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding Risk}" FontSize="10.5" Foreground="#0B0B10" FontFamily="Segoe UI Semibold"/>
                                        </Border>
                                        <Border Background="{StaticResource Brush.SurfaceHover}" CornerRadius="8" Padding="8,2" Margin="6,0,0,0"
                                                Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Admin" FontSize="10.5" Foreground="{StaticResource Brush.TextSecondary}"/>
                                        </Border>
                                        <Border Background="{StaticResource Brush.SurfaceHover}" CornerRadius="8" Padding="8,2" Margin="6,0,0,0"
                                                Visibility="{Binding RequiresReboot, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Reboot" FontSize="10.5" Foreground="{StaticResource Brush.TextSecondary}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Body}" Margin="0,6,0,0" MaxWidth="640"/>
                                    <TextBlock Text="{Binding DetailText}" Style="{StaticResource Text.Caption}" Margin="0,8,0,0"
                                               Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="{Binding UnavailableReason}" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Warning}" Margin="0,8,0,0"
                                               Visibility="{Binding IsAvailable, Converter={StaticResource InverseBoolToVis}}"/>
                                    <TextBlock Text="{Binding LastResultMessage}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0"
                                               Foreground="{StaticResource Brush.Success}"
                                               Visibility="{Binding LastResultMessage, Converter={StaticResource NullToVis}}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <Border CornerRadius="8" Padding="10,4" Background="{StaticResource Brush.SurfaceHover}"
                                            Visibility="{Binding IsApplied, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Right">
                                        <TextBlock Text="Applied" Foreground="{StaticResource Brush.Success}" FontSize="11.5" FontFamily="Segoe UI Semibold"/>
                                    </Border>
                                    <Button Content="Apply" Style="{StaticResource Button.Secondary}" Margin="0,10,0,0"
                                            Command="{Binding DataContext.ApplySingleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding IsApplied, Converter={StaticResource InverseBoolToVis}}"
                                            IsEnabled="{Binding IsAvailable}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
