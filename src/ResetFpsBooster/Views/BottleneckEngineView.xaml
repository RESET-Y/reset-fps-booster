<UserControl x:Class="ResetFpsBooster.Views.BottleneckEngineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ResetFpsBooster.ViewModels"
             d:DataContext="{d:DesignInstance vm:BottleneckEngineViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="Diagnosis.Primary" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="BorderThickness" Value="1,0,0,0"/>
        </Style>
        <Style x:Key="Evidence.Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,32" MaxWidth="920" HorizontalAlignment="Left">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Bn.Title}" Style="{StaticResource Text.Title}"/>
                    <TextBlock Text="{DynamicResource Bn.Why}" FontFamily="Segoe UI Semibold" FontSize="12.5"
                               Foreground="{DynamicResource Brush.Accent}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="{DynamicResource Bn.Start}" Style="{StaticResource Button.Primary}" Command="{Binding StartMonitoringCommand}" VerticalAlignment="Center"
                        Visibility="{Binding IsMonitoring, Converter={StaticResource InverseBoolToVis}}"/>
                <Button Grid.Column="1" Content="{DynamicResource Bn.Stop}" Style="{StaticResource Button.Secondary}" Command="{Binding StopMonitoringCommand}" VerticalAlignment="Center"
                        Visibility="{Binding IsMonitoring, Converter={StaticResource BoolToVis}}"/>
            </Grid>
            <TextBlock Style="{StaticResource Text.Body}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="{DynamicResource Bn.Intro}"/>

            <Border Style="{StaticResource Card}" Margin="0,20,0,0" Visibility="{Binding IsMonitoring, Converter={StaticResource InverseBoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Bn.NotRunning}" Style="{StaticResource Text.SectionTitle}"/>
                    <TextBlock Text="{DynamicResource Bn.Hint}" Style="{StaticResource Text.Body}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <StackPanel Visibility="{Binding IsMonitoring, Converter={StaticResource BoolToVis}}">

                <Border Style="{StaticResource Card}" Margin="0,20,0,16" Visibility="{Binding CurrentReport.GameName, Converter={StaticResource NullToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Bn.Game}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding CurrentReport.GameName}" FontFamily="{StaticResource Font.Display}" FontWeight="Black" FontStyle="Italic" FontSize="14" Margin="14,0,0,0"
                                   Foreground="{StaticResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- ============ SYSTEM BALANCED ============ -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="{Binding IsBalanced, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="{StaticResource Brush.Success}" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Bn.Balanced}" FontFamily="{StaticResource Font.Display}" FontWeight="Black" FontStyle="Italic" FontSize="16" Margin="10,0,0,0"
                                       Foreground="{StaticResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource Bn.NoBottleneck}" Style="{StaticResource Text.Body}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ============ PRIMARY ============ -->
                <Border Style="{StaticResource Diagnosis.Primary}" Margin="0,0,0,16" Visibility="{Binding IsBalanced, Converter={StaticResource InverseBoolToVis}}">
                    <StackPanel DataContext="{Binding Primary}">
                        <TextBlock Text="{DynamicResource Bn.Primary}" Style="{StaticResource Text.Telemetry}"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" FontFamily="{StaticResource Font.Display}" FontWeight="Black" FontStyle="Italic" FontSize="22" Foreground="{DynamicResource Brush.AccentBright}">
                                <Run Text="🔴 "/><Run Text="{Binding Headline}"/>
                            </TextBlock>
                            <TextBlock Grid.Column="1" FontFamily="{StaticResource Font.Display}" FontWeight="Black" FontStyle="Italic" FontSize="22" Foreground="{StaticResource Brush.TextPrimary}" VerticalAlignment="Center">
                                <Run Text="{Binding ConfidencePercent, StringFormat='{}{0:0}'}"/><Run Text="{DynamicResource Bn.Confidence}"/>
                            </TextBlock>
                        </Grid>
                        <TextBlock Text="{Binding Explanation}" Style="{StaticResource Text.Body}" Margin="0,14,0,0" TextWrapping="Wrap"/>

                        <ItemsControl ItemsSource="{Binding Evidence}" Margin="0,18,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Style="{StaticResource Evidence.Row}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="Consolas" FontSize="13"
                                                   Foreground="{StaticResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ============ SECONDARY / TERTIARY ============ -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="{Binding Secondary, Converter={StaticResource NullToVis}}">
                    <StackPanel DataContext="{Binding Secondary}">
                        <TextBlock Text="{DynamicResource Bn.Secondary}" Style="{StaticResource Text.Telemetry}"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" FontFamily="{StaticResource Font.Display}" FontWeight="Black" FontStyle="Italic" FontSize="15" Foreground="{StaticResource Brush.Warning}">
                                <Run Text="🟠 "/><Run Text="{Binding Headline}"/>
                            </TextBlock>
                            <TextBlock Grid.Column="1" FontFamily="Segoe UI Semibold" FontSize="13" Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center">
                                <Run Text="{Binding ConfidencePercent, StringFormat='{}{0:0}'}"/><Run Text="%"/>
                            </TextBlock>
                        </Grid>
                        <TextBlock Text="{Binding Explanation}" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="{Binding Tertiary, Converter={StaticResource NullToVis}}">
                    <StackPanel DataContext="{Binding Tertiary}">
                        <TextBlock Text="{DynamicResource Bn.Tertiary}" Style="{StaticResource Text.Telemetry}"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" FontFamily="{StaticResource Font.Display}" FontWeight="Black" FontStyle="Italic" FontSize="14" Foreground="{StaticResource Brush.TextSecondary}">
                                <Run Text="🟡 "/><Run Text="{Binding Headline}"/>
                            </TextBlock>
                            <TextBlock Grid.Column="1" FontFamily="Segoe UI Semibold" FontSize="12.5" Foreground="{StaticResource Brush.TextTertiary}" VerticalAlignment="Center">
                                <Run Text="{Binding ConfidencePercent, StringFormat='{}{0:0}'}"/><Run Text="%"/>
                            </TextBlock>
                        </Grid>
                        <TextBlock Text="{Binding Explanation}" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- ============ TREND HISTORY ============ -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Bn.Trend}" Style="{StaticResource Text.SectionTitle}"/>
                        <TextBlock Text="{DynamicResource Bn.TrendHint}" Style="{StaticResource Text.Caption}" Margin="0,4,0,12"/>
                        <ItemsControl ItemsSource="{Binding History}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource Brush.TextTertiary}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Kind}" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource Brush.TextSecondary}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
