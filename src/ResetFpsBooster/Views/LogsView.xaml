<UserControl x:Class="ResetFpsBooster.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ResetFpsBooster.ViewModels"
             d:DataContext="{d:DesignInstance vm:LogsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">
    <Grid Margin="36,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Change Log" Style="{StaticResource Text.Title}"/>
                <TextBlock Text="Every setting RESET FPS BOOSTER has changed, in order." Style="{StaticResource Text.Body}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Clear Log" Style="{StaticResource Button.Ghost}" Command="{Binding ClearCommand}" VerticalAlignment="Center"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="No changes recorded yet." Style="{StaticResource Text.Body}"
                           Visibility="{Binding Entries.Count, Converter={StaticResource CountToVisWhenZero}}"/>

                <ItemsControl ItemsSource="{Binding Entries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:g}'}" Style="{StaticResource Text.Caption}"/>
                                        <TextBlock Text="{Binding ModuleName}" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.AccentBright}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding SettingName}" FontFamily="Segoe UI Semibold" Foreground="{StaticResource Brush.TextPrimary}" FontSize="13.5"/>
                                        <TextBlock Style="{StaticResource Text.Body}" Margin="0,4,0,0">
                                            <Run Text="{Binding OldValue, Mode=OneWay}"/><Run Text="  →  " Foreground="{StaticResource Brush.TextTertiary}"/><Run Text="{Binding NewValue, Mode=OneWay}" Foreground="{StaticResource Brush.TextPrimary}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
