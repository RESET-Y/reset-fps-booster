<UserControl x:Class="ResetFpsBooster.Views.FrameBoostBetaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ResetFpsBooster.ViewModels"
             d:DataContext="{d:DesignInstance vm:FrameBoostBetaViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,32" MaxWidth="920" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="RESET FRAMEBOOST" Style="{StaticResource Text.Title}"/>
                <Border Background="{StaticResource Brush.Accent}" CornerRadius="3" Padding="8,3" Margin="14,4,0,0" VerticalAlignment="Top">
                    <TextBlock Text="{DynamicResource FB.Beta}" FontFamily="Segoe UI Semibold" FontSize="11" Foreground="White"/>
                </Border>
            </StackPanel>
            <TextBlock Style="{StaticResource Text.Body}" Margin="0,8,0,0" TextWrapping="Wrap"
                       Text="{DynamicResource FB.Intro}"/>

            <Border Style="{StaticResource Card}" Margin="0,20,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource FB.FrameGeneration}" Style="{StaticResource Text.SectionTitle}"/>
                    <TextBlock Text="{DynamicResource FB.MainDisplay}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0"/>

                    <!-- Before the buttons on purpose: this is set up in the game
                         BEFORE FrameBoost starts, and it decides more of the result
                         than anything on this page. -->
                    <Border Background="{StaticResource Brush.SurfaceElevated}" CornerRadius="6" Padding="12,10" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource FB.BestResult}" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextPrimary}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="{DynamicResource FB.YourMonitor}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"/>
                                <ComboBox ItemsSource="{Binding RefreshRates}" SelectedItem="{Binding DisplayHz}"
                                          ItemStringFormat="{}{0} Hz" Width="96" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding CapAdvice}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="{DynamicResource FB.GpuRoom}"/>
                            <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="{DynamicResource FB.SteadyCap}"/>
                        </StackPanel>
                    </Border>

                    <!-- PREMIUM. The lock appears only once the server has said no,
                         and the controls only once it has said yes; while the answer
                         is out, neither shows, so a paying user never sees a lock
                         flash up. -->
                    <Border Background="{StaticResource Brush.SurfaceElevated}" CornerRadius="6" Padding="16,14" Margin="0,16,0,0"
                            Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Background="{StaticResource Brush.Accent}" CornerRadius="3" Padding="8,3">
                                    <TextBlock Text="PREMIUM" FontFamily="Segoe UI Semibold" FontSize="11" Foreground="White"/>
                                </Border>
                                <TextBlock Text="{DynamicResource FB.PremiumFeature}" FontWeight="SemiBold" Margin="10,0,0,0"
                                           VerticalAlignment="Center" Foreground="{StaticResource Brush.TextPrimary}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Text="{DynamicResource FB.PremiumHint}"/>
                            <Button Content="{DynamicResource FB.GoToAccount}" Style="{StaticResource Button.Primary}" HorizontalAlignment="Left"
                                    Margin="0,12,0,0" Command="{Binding OpenAccountCommand}"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Visibility="{Binding IsPremium, Converter={StaticResource BoolToVis}}">
                        <Grid Margin="0,16,0,0">
                            <Button Content="{DynamicResource FB.TurnOn}" Style="{StaticResource Button.Primary}" Command="{Binding StartCaptureCommand}"
                                    HorizontalAlignment="Left" Visibility="{Binding IsRunning, Converter={StaticResource InverseBoolToVis}}"/>
                            <Button Content="{DynamicResource FB.TurnOff}" Style="{StaticResource Button.Secondary}" Command="{Binding StopCaptureCommand}"
                                    HorizontalAlignment="Left" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
                        </Grid>

                        <!-- Disabled while running, not hidden: the engine reads this
                             once at launch, so toggling it mid-run would look like it
                             did something and change nothing. -->
                        <CheckBox Content="{DynamicResource FB.LowLatency}" IsChecked="{Binding LowLatency}" Margin="0,16,0,0"
                                  IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}"/>
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="22,4,0,0" TextWrapping="Wrap"
                                   Text="{DynamicResource FB.LowLatencyHint}"/>

                    </StackPanel>

                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Caption}" Margin="0,10,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource Brush.Warning}" Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}"/>
                </StackPanel>
            </Border>

            <StackPanel Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                        Visibility="{Binding StatusNotice, Converter={StaticResource NullToVis}}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource FB.Status}" Style="{StaticResource Text.SectionTitle}"/>
                        <TextBlock Text="{Binding StatusNotice}" Style="{StaticResource Text.Body}"
                                   Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="{StaticResource Brush.Success}" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource FB.Active}" FontFamily="Segoe UI Semibold" FontSize="16" Margin="10,0,0,0" Foreground="{StaticResource Brush.TextPrimary}"/>
                        </StackPanel>

                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource FB.GameFps}" Style="{StaticResource Text.Caption}"/>
                                <TextBlock FontFamily="Consolas" FontSize="24" Foreground="{StaticResource Brush.TextPrimary}" Margin="0,6,0,0">
                                    <Run Text="{Binding Telemetry.SourceFps, StringFormat='{}{0:0.0}', TargetNullValue=N/A}"/>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{DynamicResource FB.GeneratedFps}" Style="{StaticResource Text.Caption}"/>
                                <TextBlock FontFamily="Consolas" FontSize="24" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,6,0,0">
                                    <Run Text="{Binding Telemetry.GeneratedFps, StringFormat='{}{0:0.0}', TargetNullValue=N/A}"/>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource FB.OutputFps}" Style="{StaticResource Text.Caption}"/>
                                <TextBlock FontFamily="Consolas" FontSize="24" Foreground="{StaticResource Brush.AccentBright}" Margin="0,6,0,0">
                                    <Run Text="{Binding Telemetry.OutputFps, StringFormat='{}{0:0.0}', TargetNullValue=N/A}"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource FB.DebugTelemetry}" Style="{StaticResource Text.SectionTitle}"/>
                        <TextBlock Text="{DynamicResource FB.DebugHint}" Style="{StaticResource Text.Caption}" Margin="0,4,0,14"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource FB.CaptureLatency}" Style="{StaticResource Text.Caption}"/>
                            <TextBlock Grid.Column="1" FontFamily="Consolas" Foreground="{StaticResource Brush.TextPrimary}">
                                <Run Text="{Binding Telemetry.CaptureLatencyMs, StringFormat='{}{0:0.00} ms', TargetNullValue=N/A}"/>
                            </TextBlock>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource FB.OnScreenAge}" Style="{StaticResource Text.Caption}"/>
                            <TextBlock Grid.Column="1" FontFamily="Consolas" Foreground="{StaticResource Brush.TextPrimary}">
                                <Run Text="{Binding Telemetry.OnScreenAgeMs, StringFormat='{}{0:0.00} ms', TargetNullValue=N/A}"/>
                            </TextBlock>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource FB.MotionGpu}" Style="{StaticResource Text.Caption}"/>
                            <TextBlock Grid.Column="1" FontFamily="Consolas" Foreground="{StaticResource Brush.TextPrimary}">
                                <Run Text="{Binding Telemetry.MotionEstimationGpuMs, StringFormat='{}{0:0.00} ms', TargetNullValue=N/A}"/>
                            </TextBlock>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource FB.InterpGpu}" Style="{StaticResource Text.Caption}"/>
                            <TextBlock Grid.Column="1" FontFamily="Consolas" Foreground="{StaticResource Brush.TextPrimary}">
                                <Run Text="{Binding Telemetry.InterpolationGpuMs, StringFormat='{}{0:0.00} ms', TargetNullValue=N/A}"/>
                            </TextBlock>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource FB.PollTime}" Style="{StaticResource Text.Caption}"/>
                            <TextBlock Grid.Column="1" FontFamily="Consolas" Foreground="{StaticResource Brush.TextTertiary}">
                                <Run Text="{Binding Telemetry.PollTimeMs, StringFormat='{}{0:0.000} ms', TargetNullValue=N/A}"/>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
