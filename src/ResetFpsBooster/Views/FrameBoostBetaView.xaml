<UserControl x:Class="ResetFpsBooster.Views.FrameBoostBetaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ResetFpsBooster.ViewModels"
             d:DataContext="{d:DesignInstance vm:FrameBoostBetaViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">
    <UserControl.Resources>
        <!-- Slanted badge, same cut as the buttons -->
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Brush.Accent}"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform"><Setter.Value><SkewTransform AngleX="-12"/></Setter.Value></Setter>
        </Style>
        <Style x:Key="BadgeText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Black"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="ReadoutLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Telemetry}">
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="DebugRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,32" MaxWidth="920" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="RESET FRAMEBOOST" Style="{StaticResource Text.Title}"/>
                <Border Style="{StaticResource Badge}" Margin="16,6,0,0" VerticalAlignment="Top">
                    <TextBlock Text="{DynamicResource FB.Beta}" Style="{StaticResource BadgeText}"/>
                </Border>
            </StackPanel>
            <TextBlock Style="{StaticResource Text.Body}" Margin="0,8,0,0" TextWrapping="Wrap"
                       Text="{DynamicResource FB.Intro}"/>

            <!-- LIVE: shown first while running, it is what the user came back for -->
            <StackPanel Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" Margin="0,20,0,0">
                <Border Style="{StaticResource Card.Accented}" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="12" Height="12" VerticalAlignment="Center">
                                <Ellipse x:Name="LivePulse" Fill="{StaticResource Brush.Success}" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" From="1" To="2.4" Duration="0:0:1.2"/>
                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" From="1" To="2.4" Duration="0:0:1.2"/>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.7" To="0" Duration="0:0:1.2"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                                <Ellipse Fill="{StaticResource Brush.Success}" Width="10" Height="10"/>
                            </Grid>
                            <TextBlock Text="{DynamicResource FB.Active}" Style="{StaticResource Text.SectionTitle}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- The whole point in one line: game fps in, output fps out -->
                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource FB.GameFps}" Style="{StaticResource ReadoutLabel}"/>
                                <TextBlock Style="{StaticResource Text.Display}"
                                           Text="{Binding Telemetry.SourceFps, StringFormat='{}{0:0}', TargetNullValue=--}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="//" Style="{StaticResource Text.Display}" Foreground="{StaticResource Brush.Accent}"
                                       Margin="18,0" VerticalAlignment="Bottom"/>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource FB.OutputFps}" Style="{StaticResource ReadoutLabel}"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Text.Display}" FontSize="64" Foreground="{StaticResource Brush.AccentBright}"
                                               Text="{Binding Telemetry.OutputFps, StringFormat='{}{0:0}', TargetNullValue=--}"/>
                                    <TextBlock Text="FPS" FontFamily="Segoe UI Black" FontStyle="Italic" FontSize="16"
                                               Foreground="{StaticResource Brush.Accent}" VerticalAlignment="Bottom" Margin="6,0,0,14"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="4" VerticalAlignment="Bottom" Margin="0,0,0,12">
                                <TextBlock Text="{DynamicResource FB.GeneratedFps}" Style="{StaticResource ReadoutLabel}" HorizontalAlignment="Right"/>
                                <TextBlock FontFamily="Segoe UI Black" FontStyle="Italic" FontSize="26" HorizontalAlignment="Right"
                                           Foreground="{StaticResource Brush.TextSecondary}"
                                           Text="{Binding Telemetry.GeneratedFps, StringFormat='+{0:0}', TargetNullValue=--}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource Text.Telemetry}" Margin="0,10,0,0">
                            <Run Text="LAT"/>
                            <Run Text="{Binding Telemetry.OnScreenAgeMs, StringFormat='{}{0:0.0}ms', TargetNullValue=--}" Foreground="{StaticResource Brush.TextPrimary}"/>
                            <Run Text="  ·  CAP"/>
                            <Run Text="{Binding Telemetry.CaptureLatencyMs, StringFormat='{}{0:0.0}ms', TargetNullValue=--}" Foreground="{StaticResource Brush.TextPrimary}"/>
                            <Run Text="  ·  GPU"/>
                            <Run Text="{Binding Telemetry.InterpolationGpuMs, StringFormat='{}{0:0.00}ms', TargetNullValue=--}" Foreground="{StaticResource Brush.TextPrimary}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                        Visibility="{Binding StatusNotice, Converter={StaticResource NullToVis}}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource FB.Status}" Style="{StaticResource Text.SectionTitle}"/>
                        <TextBlock Text="{Binding StatusNotice}" Style="{StaticResource Text.Body}"
                                   Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Style="{StaticResource Card}" Margin="0,20,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource FB.FrameGeneration}" Style="{StaticResource Text.SectionTitle}"/>
                    <TextBlock Text="{DynamicResource FB.MainDisplay}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0"/>

                    <!-- Before the buttons on purpose: this is set up in the game
                         BEFORE FrameBoost starts, and it decides more of the result
                         than anything on this page. -->
                    <Border Background="{StaticResource Brush.SurfaceElevated}" BorderBrush="{StaticResource Brush.Warning}" BorderThickness="3,0,0,0"
                            Padding="14,12" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource FB.BestResult}" FontFamily="Segoe UI Black" FontStyle="Italic" Foreground="{StaticResource Brush.TextPrimary}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="{DynamicResource FB.YourMonitor}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"/>
                                <ComboBox ItemsSource="{Binding RefreshRates}" SelectedItem="{Binding DisplayHz}"
                                          ItemStringFormat="{}{0} Hz" Width="110" Margin="10,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding CapAdvice}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="{DynamicResource FB.GpuRoom}"/>
                            <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="{DynamicResource FB.SteadyCap}"/>
                        </StackPanel>
                    </Border>

                    <!-- PREMIUM. The lock appears only once the server has said no,
                         and the controls only once it has said yes; while the answer
                         is out, neither shows, so a paying user never sees a lock
                         flash up. -->
                    <Border Background="{StaticResource Brush.SurfaceElevated}" BorderBrush="{StaticResource Brush.Accent}" BorderThickness="3,0,0,0"
                            Padding="16,14" Margin="0,16,0,0"
                            Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource Badge}">
                                    <TextBlock Text="PREMIUM" Style="{StaticResource BadgeText}"/>
                                </Border>
                                <TextBlock Text="{DynamicResource FB.PremiumFeature}" FontFamily="Segoe UI Black" FontStyle="Italic" Margin="12,0,0,0"
                                           VerticalAlignment="Center" Foreground="{StaticResource Brush.TextPrimary}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Text="{DynamicResource FB.PremiumHint}"/>
                            <Button Content="{DynamicResource FB.GoToAccount}" Style="{StaticResource Button.Primary}" HorizontalAlignment="Left"
                                    Margin="0,14,0,0" Command="{Binding OpenAccountCommand}"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Visibility="{Binding IsPremium, Converter={StaticResource BoolToVis}}">
                        <Grid Margin="0,18,0,0">
                            <Button Content="{DynamicResource FB.TurnOn}" Style="{StaticResource Button.Primary}" Command="{Binding StartCaptureCommand}"
                                    HorizontalAlignment="Left" Padding="34,14" FontSize="16"
                                    Visibility="{Binding IsRunning, Converter={StaticResource InverseBoolToVis}}"/>
                            <Button Content="{DynamicResource FB.TurnOff}" Style="{StaticResource Button.Secondary}" Command="{Binding StopCaptureCommand}"
                                    HorizontalAlignment="Left" Padding="34,14" FontSize="16"
                                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
                        </Grid>

                        <!-- Disabled while running, not hidden: the engine reads this
                             once at launch, so toggling it mid-run would look like it
                             did something and change nothing. -->
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding LowLatency}" VerticalAlignment="Center"
                                      IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}"/>
                            <TextBlock Text="{DynamicResource FB.LowLatency}" FontFamily="Segoe UI Bold" FontStyle="Italic" Margin="12,0,0,0"
                                       VerticalAlignment="Center" Foreground="{StaticResource Brush.TextPrimary}"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="54,4,0,0" TextWrapping="Wrap"
                                   Text="{DynamicResource FB.LowLatencyHint}"/>
                    </StackPanel>

                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Caption}" Margin="0,10,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource Brush.Warning}" Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource FB.DebugTelemetry}" Style="{StaticResource Text.SectionTitle}"/>
                    <TextBlock Text="{DynamicResource FB.DebugHint}" Style="{StaticResource Text.Caption}" Margin="0,4,0,14"/>

                    <Grid Style="{StaticResource DebugRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource FB.CaptureLatency}" Style="{StaticResource Text.Caption}"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource Text.Telemetry}" Foreground="{StaticResource Brush.TextPrimary}"
                                   Text="{Binding Telemetry.CaptureLatencyMs, StringFormat='{}{0:0.00} ms', TargetNullValue=N/A}"/>
                    </Grid>
                    <Grid Style="{StaticResource DebugRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource FB.OnScreenAge}" Style="{StaticResource Text.Caption}"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource Text.Telemetry}" Foreground="{StaticResource Brush.TextPrimary}"
                                   Text="{Binding Telemetry.OnScreenAgeMs, StringFormat='{}{0:0.00} ms', TargetNullValue=N/A}"/>
                    </Grid>
                    <Grid Style="{StaticResource DebugRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource FB.MotionGpu}" Style="{StaticResource Text.Caption}"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource Text.Telemetry}" Foreground="{StaticResource Brush.TextPrimary}"
                                   Text="{Binding Telemetry.MotionEstimationGpuMs, StringFormat='{}{0:0.00} ms', TargetNullValue=N/A}"/>
                    </Grid>
                    <Grid Style="{StaticResource DebugRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource FB.InterpGpu}" Style="{StaticResource Text.Caption}"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource Text.Telemetry}" Foreground="{StaticResource Brush.TextPrimary}"
                                   Text="{Binding Telemetry.InterpolationGpuMs, StringFormat='{}{0:0.00} ms', TargetNullValue=N/A}"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource FB.PollTime}" Style="{StaticResource Text.Caption}"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource Text.Telemetry}"
                                   Text="{Binding Telemetry.PollTimeMs, StringFormat='{}{0:0.000} ms', TargetNullValue=N/A}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
