<UserControl x:Class="ResetFpsBooster.Views.FrameBoostBetaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ResetFpsBooster.ViewModels"
             d:DataContext="{d:DesignInstance vm:FrameBoostBetaViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,32" MaxWidth="920" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="RESET FRAMEBOOST" Style="{StaticResource Text.Title}"/>
                <Border Background="{StaticResource Brush.Accent}" CornerRadius="3" Padding="8,3" Margin="14,4,0,0" VerticalAlignment="Top">
                    <TextBlock Text="EXPERIMENTAL BETA" FontFamily="Segoe UI Semibold" FontSize="11" Foreground="White"/>
                </Border>
            </StackPanel>
            <TextBlock Style="{StaticResource Text.Body}" Margin="0,8,0,0" TextWrapping="Wrap"
                       Text="System-level frame generation for any Windows application window, via the public Windows Graphics Capture API — no game modification, no injection, no memory access. Displays the boosted result in its own separate window. Real, measured numbers only; a value shows N/A rather than a guess when it cannot be measured."/>

            <Border Style="{StaticResource Card}" Margin="0,20,0,16">
                <StackPanel>
                    <TextBlock Text="Target window" Style="{StaticResource Text.SectionTitle}"/>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableWindows}" SelectedItem="{Binding SelectedWindow}"
                                  DisplayMemberPath="Title" IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}"/>
                        <Button Grid.Column="1" Content="Refresh" Style="{StaticResource Button.Secondary}" Command="{Binding RefreshWindowsCommand}"
                                Margin="10,0,0,0" IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}"/>
                    </Grid>

                    <Grid Margin="0,16,0,0">
                        <Button Content="Start FrameBoost" Style="{StaticResource Button.Primary}" Command="{Binding StartCaptureCommand}"
                                HorizontalAlignment="Left" Visibility="{Binding IsRunning, Converter={StaticResource InverseBoolToVis}}"/>
                        <Button Content="Stop FrameBoost" Style="{StaticResource Button.Secondary}" Command="{Binding StopCaptureCommand}"
                                HorizontalAlignment="Left" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
                    </Grid>

                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Caption}" Margin="0,10,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource Brush.Warning}" Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}"/>
                </StackPanel>
            </Border>

            <StackPanel Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="{StaticResource Brush.Success}" VerticalAlignment="Center"/>
                            <TextBlock Text="ACTIVE" FontFamily="Segoe UI Semibold" FontSize="16" Margin="10,0,0,0" Foreground="{StaticResource Brush.TextPrimary}"/>
                        </StackPanel>

                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="NATIVE FPS" Style="{StaticResource Text.Caption}"/>
                                <TextBlock FontFamily="Consolas" FontSize="24" Foreground="{StaticResource Brush.TextPrimary}" Margin="0,6,0,0">
                                    <Run Text="{Binding Telemetry.NativeFps, StringFormat='{}{0:0.0}', TargetNullValue=N/A}"/>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="GENERATED FPS" Style="{StaticResource Text.Caption}"/>
                                <TextBlock FontFamily="Consolas" FontSize="24" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,6,0,0">
                                    <Run Text="{Binding Telemetry.GeneratedFps, StringFormat='{}{0:0.0}', TargetNullValue=N/A}"/>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="OUTPUT FPS" Style="{StaticResource Text.Caption}"/>
                                <TextBlock FontFamily="Consolas" FontSize="24" Foreground="{StaticResource Brush.AccentBright}" Margin="0,6,0,0">
                                    <Run Text="{Binding Telemetry.OutputFps, StringFormat='{}{0:0.0}', TargetNullValue=N/A}"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Debug telemetry" Style="{StaticResource Text.SectionTitle}"/>
                        <TextBlock Text="Real, measured values from the native engine — never fabricated." Style="{StaticResource Text.Caption}" Margin="0,4,0,14"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Capture latency (real, avg)" Style="{StaticResource Text.Caption}"/>
                            <TextBlock Grid.Column="1" FontFamily="Consolas" Foreground="{StaticResource Brush.TextPrimary}">
                                <Run Text="{Binding Telemetry.CaptureLatencyMs, StringFormat='{}{0:0.00} ms', TargetNullValue=N/A}"/>
                            </TextBlock>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Motion estimation GPU time" Style="{StaticResource Text.Caption}"/>
                            <TextBlock Grid.Column="1" FontFamily="Consolas" Foreground="{StaticResource Brush.TextPrimary}">
                                <Run Text="{Binding Telemetry.MotionEstimationGpuMs, StringFormat='{}{0:0.00} ms', TargetNullValue=N/A}"/>
                            </TextBlock>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Interpolation GPU time" Style="{StaticResource Text.Caption}"/>
                            <TextBlock Grid.Column="1" FontFamily="Consolas" Foreground="{StaticResource Brush.TextPrimary}">
                                <Run Text="{Binding Telemetry.InterpolationGpuMs, StringFormat='{}{0:0.00} ms', TargetNullValue=N/A}"/>
                            </TextBlock>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Poll time" Style="{StaticResource Text.Caption}"/>
                            <TextBlock Grid.Column="1" FontFamily="Consolas" Foreground="{StaticResource Brush.TextTertiary}">
                                <Run Text="{Binding Telemetry.PollTimeMs, StringFormat='{}{0:0.000} ms', TargetNullValue=N/A}"/>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
