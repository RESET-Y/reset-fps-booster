<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>ResetFpsBooster</AssemblyName>
    <RootNamespace>ResetFpsBooster</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <Configurations>Debug;Release;Beta</Configurations>
    <Company>Lukas Reschke</Company>
    <Product>RESET FPS BOOSTER</Product>
    <Version>1.2.5</Version>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Beta-only configuration: this is the ONLY place RFB_BETA is defined.
       Debug and Release (what Stable is always built/published from) never
       see this symbol, so every #if RFB_BETA block below is completely
       compiled out of the Stable build - not hidden at runtime, genuinely
       absent from the binary. This is the isolation mechanism requested for
       RESET FRAMEBOOST. -->
  <PropertyGroup Condition="'$(Configuration)'=='Beta'">
    <DefineConstants>$(DefineConstants);RFB_BETA</DefineConstants>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!-- The real isolation mechanism for the Stable build: every RESET
       FRAMEBOOST BETA file follows the "*FrameBoostBeta*" naming
       convention, so outside the Beta configuration those files are
       entirely removed from compilation - not just excluded via #if in the
       .cs files (which XAML can't use), but genuinely absent from Stable's
       build graph. -->
  <ItemGroup Condition="'$(Configuration)' != 'Beta'">
    <Compile Remove="**\*FrameBoostBeta*.cs" />
    <Page Remove="**\*FrameBoostBeta*.xaml" />
    <None Include="**\*FrameBoostBeta*.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <!-- Wraps NVIDIA's public NVAPI so the "NVIDIA Max Performance" module can read/write the same
         global driver settings the NVIDIA Control Panel itself exposes. LGPL-3.0 — usable in
         closed-source projects since we only consume the compiled package, not modify it. -->
    <PackageReference Include="NvAPIWrapper.Net" Version="0.8.1.101" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\logo_wide.png" />
    <Resource Include="Assets\logo_square.png" />
  </ItemGroup>

  <!-- Beta-only: ship the native FrameBoost engine (built separately via
       native/FrameBoostBeta/build.ps1 + CMake, not by this csproj) next to
       the app's own exe, in its own subfolder. -->
  <ItemGroup Condition="'$(Configuration)'=='Beta'">
    <Content Include="..\..\native\FrameBoostBeta\build\bin\FrameBoostBeta.exe" Condition="Exists('..\..\native\FrameBoostBeta\build\bin\FrameBoostBeta.exe')">
      <Link>FrameBoostBeta\FrameBoostBeta.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- MediaElement plays from a real file on disk (it can't stream from an embedded pack
         resource), so the intro video ships as a loose file next to the exe instead. -->
    <Content Include="Assets\intro.mp4">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <!-- Single-file publish otherwise bundles this into the exe blob instead of leaving it as
           a loose file — but MediaElement needs a real file path on disk to play from. -->
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

</Project>
