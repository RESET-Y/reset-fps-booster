<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>ResetFpsBooster</AssemblyName>
    <RootNamespace>ResetFpsBooster</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <Configurations>Debug;Release</Configurations>
    <Company>Lukas Reschke</Company>
    <Product>RESET FPS BOOSTER</Product>
    <Version>1.5.0</Version>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <!-- Wraps NVIDIA's public NVAPI so the "NVIDIA Max Performance" module can read/write the same
         global driver settings the NVIDIA Control Panel itself exposes. LGPL-3.0 — usable in
         closed-source projects since we only consume the compiled package, not modify it. -->
    <PackageReference Include="NvAPIWrapper.Net" Version="0.8.1.101" />
    <!-- The tray icon: minimizing the window hides it from the taskbar and
         leaves the icon in the notification area instead. MIT. -->
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\logo_wide.png" />
    <Resource Include="Assets\logo_square.png" />
    <!-- Saira Condensed (SIL OFL 1.1, see Assets\Fonts\OFL-SairaCondensed.txt): the brand face. -->
    <Resource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>

  <!-- Ship the native FrameBoost V2 engine (built separately via
       native/FrameBoostV2/build.ps1 + CMake, not by this csproj) next to the
       app's own exe, in its own subfolder. FrameBoost and Smooth Motion are
       part of the product in every configuration.

       Once an Exists() condition quietly dropped the engine from every build:
       nothing failed, the app simply had no FrameBoost to start. Hence
       RequireFrameBoostEngine: a Release build without its engine stops
       instead of shipping. -->
  <Target Name="RequireFrameBoostEngine" BeforeTargets="Build" Condition="'$(Configuration)'=='Release'">
    <Error Condition="!Exists('..\..\native\FrameBoostV2\build\bin\FrameBoostBeta.exe')"
           Text="FrameBoost V2 engine not built: run native/FrameBoostV2/build.ps1 first. A Release build without it would ship an app whose FrameBoost cannot start." />
  </Target>

  <!-- Debug builds may run without the engine (the page then says so); Release never does. -->
  <ItemGroup Condition="'$(Configuration)'=='Release' Or Exists('..\..\native\FrameBoostV2\build\bin\FrameBoostBeta.exe')">
    <Content Include="..\..\native\FrameBoostV2\build\bin\FrameBoostBeta.exe">
      <Link>FrameBoostBeta\FrameBoostBeta.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
