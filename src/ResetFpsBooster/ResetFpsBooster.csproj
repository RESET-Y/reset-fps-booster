<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>ResetFpsBooster</AssemblyName>
    <RootNamespace>ResetFpsBooster</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <Company>Lukas Reschke</Company>
    <Product>RESET FPS BOOSTER</Product>
    <Version>1.2.2</Version>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <!-- Wraps NVIDIA's public NVAPI so the "NVIDIA Max Performance" module can read/write the same
         global driver settings the NVIDIA Control Panel itself exposes. LGPL-3.0 — usable in
         closed-source projects since we only consume the compiled package, not modify it. -->
    <PackageReference Include="NvAPIWrapper.Net" Version="0.8.1.101" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\logo_wide.png" />
    <Resource Include="Assets\logo_square.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- MediaElement plays from a real file on disk (it can't stream from an embedded pack
         resource), so the intro video ships as a loose file next to the exe instead. -->
    <Content Include="Assets\intro.mp4">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <!-- Single-file publish otherwise bundles this into the exe blob instead of leaving it as
           a loose file — but MediaElement needs a real file path on disk to play from. -->
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

</Project>
