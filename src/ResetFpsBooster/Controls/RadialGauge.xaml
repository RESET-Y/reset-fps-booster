<UserControl x:Class="ResetFpsBooster.Controls.RadialGauge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <!-- Telemetry readout: a big slanted number over a segmented bar, like a
         dash display. Still called RadialGauge so every page keeps working. -->
    <StackPanel HorizontalAlignment="Left">
        <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="CenterText" Text="{Binding CenterLabel, ElementName=Root}" FontFamily="Segoe UI Black" FontStyle="Italic"
                       Foreground="{StaticResource Brush.TextPrimary}" VerticalAlignment="Bottom"/>
            <TextBlock Text="{Binding Unit, ElementName=Root}" FontFamily="Segoe UI Black" FontStyle="Italic" FontSize="13"
                       Foreground="{Binding AccentBrush, ElementName=Root}" VerticalAlignment="Bottom" Margin="4,0,0,6"
                       Visibility="{Binding ShowUnit, ElementName=Root, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>
        <StackPanel x:Name="Segments" Orientation="Horizontal" Margin="0,6,0,0"/>
    </StackPanel>
</UserControl>
