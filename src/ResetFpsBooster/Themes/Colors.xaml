<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Base surfaces — true black, RFB style -->
    <Color x:Key="Color.Background">#000000</Color>
    <Color x:Key="Color.Surface">#0D0D0D</Color>
    <Color x:Key="Color.SurfaceElevated">#161616</Color>
    <Color x:Key="Color.SurfaceHover">#201414</Color>
    <Color x:Key="Color.Border">#2A2020</Color>
    <Color x:Key="Color.BorderSubtle">#1A1414</Color>

    <!-- Accent — RFB red -->
    <Color x:Key="Color.Accent">#E8121F</Color>
    <Color x:Key="Color.AccentBright">#FF3242</Color>
    <Color x:Key="Color.AccentDeep">#7A0A10</Color>
    <Color x:Key="Color.AccentMuted">#4A1216</Color>
    <Color x:Key="Color.Cyan">#FF3242</Color>

    <!-- Status -->
    <Color x:Key="Color.Success">#3DD68C</Color>
    <Color x:Key="Color.Warning">#F5A623</Color>
    <Color x:Key="Color.Danger">#E8121F</Color>

    <!-- Text -->
    <Color x:Key="Color.TextPrimary">#FFFFFF</Color>
    <Color x:Key="Color.TextSecondary">#B0AEAE</Color>
    <Color x:Key="Color.TextTertiary">#6E6A6A</Color>

    <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}"/>
    <SolidColorBrush x:Key="Brush.SurfaceElevated" Color="{StaticResource Color.SurfaceElevated}"/>
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="{StaticResource Color.SurfaceHover}"/>
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}"/>
    <SolidColorBrush x:Key="Brush.BorderSubtle" Color="{StaticResource Color.BorderSubtle}"/>

    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}"/>
    <SolidColorBrush x:Key="Brush.AccentBright" Color="{StaticResource Color.AccentBright}"/>
    <SolidColorBrush x:Key="Brush.AccentDeep" Color="{StaticResource Color.AccentDeep}"/>
    <SolidColorBrush x:Key="Brush.AccentMuted" Color="{StaticResource Color.AccentMuted}"/>
    <SolidColorBrush x:Key="Brush.Cyan" Color="{StaticResource Color.Cyan}"/>

    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}"/>
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}"/>
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}"/>

    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}"/>
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="{StaticResource Color.TextTertiary}"/>

    <LinearGradientBrush x:Key="Brush.AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource Color.AccentBright}" Offset="0"/>
        <GradientStop Color="{StaticResource Color.AccentDeep}" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.AccentGradientHorizontal" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource Color.Accent}" Offset="0"/>
        <GradientStop Color="{StaticResource Color.AccentBright}" Offset="0.5"/>
        <GradientStop Color="{StaticResource Color.Accent}" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.HeroGlow" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#33E8121F" Offset="0"/>
        <GradientStop Color="#00000000" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>
