<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Red, black and white (the palette Lukas pinned on 2026-10-09). Black is the
         stage, red the light, white the type and the flash. -->
    <Color x:Key="Color.Background">#050505</Color>
    <Color x:Key="Color.Surface">#0C0C0C</Color>
    <Color x:Key="Color.SurfaceElevated">#141414</Color>
    <Color x:Key="Color.SurfaceHover">#1C1C1C</Color>
    <Color x:Key="Color.Border">#262626</Color>
    <Color x:Key="Color.BorderSubtle">#181818</Color>

    <!-- Accent — RFB red -->
    <Color x:Key="Color.Accent">#E8121F</Color>
    <Color x:Key="Color.AccentBright">#FF3242</Color>
    <Color x:Key="Color.AccentDeep">#7A0A10</Color>
    <Color x:Key="Color.AccentMuted">#4A1216</Color>
    <Color x:Key="Color.Cyan">#FF3242</Color>

    <!-- Status -->
    <Color x:Key="Color.Success">#3DD68C</Color>
    <Color x:Key="Color.Warning">#F5A623</Color>
    <Color x:Key="Color.Danger">#E8121F</Color>

    <!-- Text -->
    <Color x:Key="Color.TextPrimary">#FFFFFF</Color>
    <Color x:Key="Color.TextSecondary">#A8A8A8</Color>
    <Color x:Key="Color.TextTertiary">#8C8C8C</Color>

    <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}"/>
    <SolidColorBrush x:Key="Brush.SurfaceElevated" Color="{StaticResource Color.SurfaceElevated}"/>
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="{StaticResource Color.SurfaceHover}"/>
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}"/>
    <SolidColorBrush x:Key="Brush.BorderSubtle" Color="{StaticResource Color.BorderSubtle}"/>

    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}"/>
    <SolidColorBrush x:Key="Brush.AccentBright" Color="{StaticResource Color.AccentBright}"/>
    <SolidColorBrush x:Key="Brush.AccentDeep" Color="{StaticResource Color.AccentDeep}"/>
    <SolidColorBrush x:Key="Brush.AccentMuted" Color="{StaticResource Color.AccentMuted}"/>
    <SolidColorBrush x:Key="Brush.Cyan" Color="{StaticResource Color.Cyan}"/>

    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}"/>
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}"/>
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}"/>

    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}"/>
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="{StaticResource Color.TextTertiary}"/>

    <LinearGradientBrush x:Key="Brush.AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource Color.AccentBright}" Offset="0"/>
        <GradientStop Color="{StaticResource Color.AccentDeep}" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.AccentGradientHorizontal" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource Color.Accent}" Offset="0"/>
        <GradientStop Color="{StaticResource Color.AccentBright}" Offset="0.5"/>
        <GradientStop Color="{StaticResource Color.Accent}" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.HeroGlow" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#33E8121F" Offset="0"/>
        <GradientStop Color="#00000000" Offset="1"/>
    </LinearGradientBrush>

    <!-- Cards are opaque: see-through cards over the horizon gradients were drawn with white patches. -->
    <SolidColorBrush x:Key="Brush.Card" Color="#FF0C0C0C"/>
    <LinearGradientBrush x:Key="Brush.CardAccent" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#33E8121F" Offset="0"/>
        <GradientStop Color="#FF0C0C0C" Offset="0.55"/>
    </LinearGradientBrush>
    <!-- A stage inside a card: dark at the top, a deep red horizon at the bottom edge. -->
    <LinearGradientBrush x:Key="Brush.StageFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F00C0C0C" Offset="0"/>
        <GradientStop Color="#F00C0C0C" Offset="0.5"/>
        <GradientStop Color="#E0300306" Offset="1"/>
    </LinearGradientBrush>
    <!-- Selected nav entry: red light from the left, fading out to the right. -->
    <LinearGradientBrush x:Key="Brush.NavActive" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#40E8121F" Offset="0"/>
        <GradientStop Color="#00E8121F" Offset="1"/>
    </LinearGradientBrush>

    <!-- The horizon under the whole window: deep red rising out of black along the
         bottom edge, a brighter red glow in the middle of it. Static, painted once. -->
    <LinearGradientBrush x:Key="Brush.Horizon" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#007A0A10" Offset="0"/>
        <GradientStop Color="#447A0A10" Offset="0.6"/>
        <GradientStop Color="#99300306" Offset="1"/>
    </LinearGradientBrush>
    <!-- The ellipse reaches past the rectangle on every side and fades out at 0.7, so its edge
         never lies inside the picture: an edge under a see-through card rendered as a white dome. -->
    <RadialGradientBrush x:Key="Brush.HorizonGlow" Center="0.5,1" GradientOrigin="0.5,1" RadiusX="0.8" RadiusY="1.4">
        <GradientStop Color="#55E8121F" Offset="0"/>
        <GradientStop Color="#00E8121F" Offset="0.7"/>
    </RadialGradientBrush>

    <!-- The brand display face: Saira Condensed (SIL OFL), embedded in the app. -->
    <FontFamily x:Key="Font.Display">pack://application:,,,/Assets/Fonts/#Saira Condensed</FontFamily>

</ResourceDictionary>
