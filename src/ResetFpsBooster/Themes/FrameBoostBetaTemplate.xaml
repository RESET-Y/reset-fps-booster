<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:ResetFpsBooster.ViewModels"
                    xmlns:views="clr-namespace:ResetFpsBooster.Views">
    <!-- FrameBoost's page template, merged in from App.xaml.cs at start-up. -->
    <DataTemplate DataType="{x:Type vm:FrameBoostBetaViewModel}">
        <views:FrameBoostBetaView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SmoothMotionViewModel}">
        <views:SmoothMotionView/>
    </DataTemplate>
</ResourceDictionary>
